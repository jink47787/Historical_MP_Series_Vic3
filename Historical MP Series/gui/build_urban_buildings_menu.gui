# HMPS: vanilla 1.15.2 plus queue tools Alt-click to front (freethebrain, Workshop 3837831783, v0.6.0); MP checks removed
right_click_menu = {
	name = "build_urban_buildings_menu"

	parentanchor = top|right
	widgetanchor = top|left

	blockoverride "title_text" {
		text = "BUILD_URBAN_BUILDINGS"
	}

	blockoverride "items" {
		datamodel = "[StatesPanel.AccessState.GetPotentialUrbanBuildings]"

		item = {
			right_click_menu_item = {
				blockoverride "properties" {
					tooltip = "[Building.GetQueueConstructionTooltip]"
					# HMPS: queue tools Alt-click to front (freethebrain)
					pressed_modifiers = {
onalt = "[GetVariableSystem.Set('vqbs_alt', 'yes')]"
ondefault = "[GetVariableSystem.Clear('vqbs_alt')]"
}
onmousehierarchyleave = "[GetVariableSystem.Clear('vqbs_alt')]"
onclick = "[GetVariableSystem.Set('vqbs_overlap', Select_CString(And(GetVariableSystem.Exists('vqbs_phase'), Not(And(And(GetVariableSystem.HasValue('vqbs_phase', 'wait'), GetVariableSystem.HasValue('vqbs_single_settled', 'yes')), GetVariableSystem.HasValue('vqbs_old_size', ToString_int32(Subtract_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), '(int32)1')))))), 'yes', 'no'))]"
onclick = "[GetVariableSystem.Set('vqbs_watch_slot', Select_CString(GetVariableSystem.HasValue('vqbs_watch_slot', 'a'), 'b', 'a'))]"
onclick = "[GetVariableSystem.Clear('vqbs_phase')]"
onclick = "[GetVariableSystem.Clear('vqbs_batch')]"
onclick = "[GetVariableSystem.Clear('vqbs_single_settled')]"
onclick = "[GetVariableSystem.Clear('vqbs_five_settled')]"
onclick = "[GetVariableSystem.Clear('vqbs_old_head')]"
onclick = "[GetVariableSystem.Clear('vqbs_old_tail')]"
onclick = "[PdxGuiTriggerAllAnimations('vqbs_capture_before')]"
onclick = "[GetVariableSystem.Set('vqbs_old_size', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))]"
onclick = "[GetVariableSystem.Set('vqbs_old_levels', ToString_int32(Building.GetExpansionLevelsInQueue))]"
onclick = "[GetVariableSystem.Set('vqbs_old_built', ToString_int32(Building.GetExpansionLevel))]"
onclick = "[GetVariableSystem.Set('vqbs_old_max', ToString_int32(Building.GetState.GetMaxPotentialFor(Building.Self)))]"
onclick = "[GetVariableSystem.Set('vqbs_capacity', ToString_int32(Max_int32('(int32)0', Subtract_int32(Building.GetState.GetMaxPotentialFor(Building.Self), Add_int32(Building.GetExpansionLevel, Building.GetExpansionLevelsInQueue)))))]"
onclick = "[GetVariableSystem.Set('vqbs_target_state', Building.AccessState.GetIDString)]"
onclick = "[GetVariableSystem.Set('vqbs_target_type', Building.GetBuildingType.GetKey)]"
onclick = "[GetVariableSystem.SetIf('vqbs_phase', 'wait', And(And(And(GetVariableSystem.HasValue('vqbs_alt', 'yes'), IsValid( Building.QueueConstruction )), GreaterThan_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), '(int32)0')), Not(GetVariableSystem.HasValue('vqbs_overlap', 'yes'))))]"
onclick = "[GetVariableSystem.Clear('vqbs_alt')]"
onclick = "[Execute( Building.QueueConstruction )]"
					enabled = "[IsValid( Building.QueueConstruction )]"

					icon = {
						size = { 44 44 }
					}
				}

				blockoverride "margin" {
					margin_left = 54
				}

				blockoverride "sound" {
					using = build_button_sound
				}

				blockoverride "texture" {
					texture = "[Building.GetIcon]"
				}
				
				blockoverride = "text" {
					text = "[Building.GetNameNoFormatting]"
				}	
			}
		}
	}
}