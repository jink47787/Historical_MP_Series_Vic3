types market_panel {
    type trade_partners_charts = flowcontainer {
        spacing = 10
        compact_chart = {
            blockoverride "datamodel" {
                datamodel = "[Market.GetOwner.MakeScope.GetList('trade_partners_export_partners')]"
            }

            blockoverride "show_more_button_visibility" {
                visible = "[GreaterThan_int32(GetDataModelSize(Market.GetOwner.MakeScope.GetList('trade_partners_export_partners')), '(int32)3')]"
            }

            blockoverride "heading" {
                text = "TRADE_PARTNERS_EXPORT_PARTNERS_GRAPH_TITLE"
            }

            blockoverride "tooltip" {
                tooltip = "TRADE_PARTNERS_EXPORT_PARTNERS_TITLE"
                tooltipwidget = {
                    RegularTooltip_MarketWorldMarketExportPartners = {}
                }
            }

            blockoverride "pieslice" {
                # Stored weekly by trade_partners_market_update, in list order
                value = "[TradePartnersGetRankValue(Market.GetOwner, 'trade_partners_export_value_', PdxGuiWidget.GetIndexInDataModel)]"
            }

            blockoverride "color" {
                color = "[Scope.GetMarket.GetOwner.GetMapColor]"
            }
            
            blockoverride "pie_item_goto_button" {
                button = {
                    using = clean_button
                    size = { 100% 100% }
                    onclick = "[InformationPanelBar.OpenMarketPanel(Scope.GetMarket.Self)]"    
                }
            }

            blockoverride "leftside_info" {
                visible = no
            }

            blockoverride "rightside1_info" {
                raw_text = " [Scope.GetMarket.GetOwner.GetFlagTextIcon] @money![TradePartnersGetRankValue(Market.GetOwner, 'trade_partners_export_value_', PdxGuiWidget.AccessParent.AccessParent.GetIndexInDataModel)|vD]"
            }

            blockoverride "rightside2_info" {
                visible = no
            }
        }

        compact_chart = {
            blockoverride "datamodel" {
                datamodel = "[Market.GetOwner.MakeScope.GetList('trade_partners_import_partners')]"
            }

            blockoverride "show_more_button_visibility" {
                visible = "[GreaterThan_int32(GetDataModelSize(Market.GetOwner.MakeScope.GetList('trade_partners_import_partners')), '(int32)3')]"
            }

            blockoverride "heading" {
                text = "TRADE_PARTNERS_IMPORT_PARTNERS_GRAPH_TITLE"
            }

            blockoverride "tooltip" {
                tooltip = "TRADE_PARTNERS_IMPORT_PARTNERS_TITLE"
                tooltipwidget = {
                    RegularTooltip_MarketWorldMarketImportPartners = {}
                }
            }

            blockoverride "pieslice" {
                # Stored weekly by trade_partners_market_update, in list order
                value = "[TradePartnersGetRankValue(Market.GetOwner, 'trade_partners_import_value_', PdxGuiWidget.GetIndexInDataModel)]"
            }

            blockoverride "color" {
                color = "[Scope.GetMarket.GetOwner.GetMapColor]"
            }
            
            blockoverride "pie_item_goto_button" {
                button = {
                    using = clean_button
                    size = { 100% 100% }
                    onclick = "[InformationPanelBar.OpenMarketPanel(Scope.GetMarket.Self)]"    
                }
            }

            blockoverride "leftside_info" {
                visible = no
            }

            blockoverride "rightside1_info" {
                raw_text = " [Scope.GetMarket.GetOwner.GetFlagTextIcon] @money![TradePartnersGetRankValue(Market.GetOwner, 'trade_partners_import_value_', PdxGuiWidget.AccessParent.AccessParent.GetIndexInDataModel)|vD]"
            }

            blockoverride "rightside2_info" {
                visible = no
            }
        }
    }
}
