	name = "research_queue"
	visible = "[Or(And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), Not(GetVariableSystem.HasValue('v3rqo_viewbottom', '0'))), And(Not(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide'))), Not(IsDataModelEmpty(AccessPlayer.GetResearchQueueBottom))))]"

