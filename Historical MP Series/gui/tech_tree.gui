		name = "tech_tree_panel"
		enabled = yes

		blockoverride "animation_state_block" {
			state = {
				name = _show
				on_start = "[GetVariableSystem.Clear('v3rqa_tree_visible')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_visual')]"
				on_start = "[GetVariableSystem.Set('v3rqo_phase', 'discover')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_request')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_ready')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_done')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_player')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_observed_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_first_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_first_country')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_coverage1')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_coverage2')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_count')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_expected_count')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot1')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot2')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot3')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot4')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot5')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot6')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot7')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot8')]"
				on_start = "[GetVariableSystem.Clear('v3rqa_manual_names')]"
				on_start = "[GetVariableSystem.Set('v3rqa_tree_visible', '1')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"

				}
			}

			state = {
				name = _hide
				on_start = "[GetVariableSystem.Clear('v3rqa_tree_visible')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_visual')]"
				on_start = "[GetVariableSystem.Set('v3rqo_phase', 'discover')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_request')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_ready')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_done')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_player')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_observed_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_first_active')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_first_country')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_coverage1')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_coverage2')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_count')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_expected_count')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot1')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot2')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot3')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot4')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot5')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot6')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot7')]"
				on_start = "[GetVariableSystem.Clear('v3rqo_slot8')]"
				on_start = "[GetVariableSystem.Clear('v3rqa_manual_names')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/technology_stop"
				}
			}
		}
		
		blockoverride "window_header_name"
		{
			text = "TECH_TREE"
		}

		blockoverride "fixed_top" {
			hbox = {
				spacing = 20
				margin = { 28 10 }
				margin_bottom = 15
				layoutpolicy_horizontal = growing
				
				### HAS NO RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[Not(GetPlayer.HasCurrentlyResearchedTechnology)]"
					margin = { 25 12 }
					
					using = entry_bg_fancy
					
					vbox = {
						layoutpolicy_horizontal = growing
						
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "NO_ACTIVE_RESEARCH"
							using = fontsize_large
							align = left|nobaseline
							alpha = 0.5
						}
						textbox = {
							layoutpolicy_horizontal = growing
							autoresize = yes
							text = "RESEARCH_PANEL"
							using = fontsize_xxl
							align = left|nobaseline
							
							using = look_at_me_text_animation
						}
					}
				}
				
				### CURRENT RESEARCH
				hbox = {
					layoutpolicy_horizontal = growing
					layoutstretchfactor_horizontal = 5
					visible = "[GetPlayer.HasCurrentlyResearchedTechnology]"
					datacontext = "[AccessPlayer.AccessCurrentlyResearchedTechnology]"

					spacing = 10
					margin = { 15 7 }
					margin_right = 25

					background = {
						using = entry_bg_simple
					}
					
					widget = {
						size = { 80 80 }
                        visible = "[Not(And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), GetVariableSystem.HasValue('v3rqo_viewpromotion', '1')))]"

						icon = {
							parentanchor = center
							using = rotate_glow_animation_02
							size = { 250% 250% }
						}

						icon = {
							size = { 100% 100% }
							parentanchor = center
							texture = "[Technology.GetTexture]"

							tooltipwidget = {
								FancyTooltip_Technology = {}
							}

							### ERA
							widget = {
								size = { 25 25 }
								parentanchor = hcenter|bottom
							
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/backgrounds/round_button_bg.dds"
								}
								
								textbox = {
									text = "TECHNOLOGY_TYPE_DESCRIPTION"
									align = center|nobaseline
									parentanchor = center
								}
							}
						}

						icon = {
        name = "v3rqa_promoted_accent"
        parentanchor = hcenter|bottom
        position = { 0 -1 }
        size = { 36 2 }
        texture = "gfx/interface/backgrounds/white.dds"
        color = { 0.98 0.86 0.55 0.9 }
        visible = "[GetVariableSystem.HasValue('v3rqo_visual', 'accent')]"
        alwaystransparent = yes
    }
                        button_icon_cancel = {
							parentanchor = top|right
							size = { 25 25 }
							tooltip = "REMOVE_CURRENT_RESEARCH_TECH_FROM_QUEUE"
							using = tooltip_ne
							onclick = "[Execute(Technology.RemoveFromQueue(GetPlayer.Self))]"
							enabled = "[IsValid(Technology.RemoveFromQueue(GetPlayer.Self))]"
						}
					}
				
					### TEXT + PROGRESS
					vbox = {
						spacing = 5
                        visible = "[Not(And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), GetVariableSystem.HasValue('v3rqo_viewpromotion', '1')))]"
						
						hbox = {
							layoutpolicy_horizontal = expanding

							textbox = {
								max_width = 250
								autoresize = yes
								align = nobaseline
								raw_text = "#variable [Technology.GetNameNoFormatting]#!"
								using = fontsize_large
								using = elide_fontsize_min

								tooltipwidget = {
									FancyTooltip_Technology = {}
								}
							}

							expand = {}

							textbox = {
								visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
								max_width = 150
								autoresize = yes
								margin_left = 10
								align = right|nobaseline
								using = elide_fontsize_min
								tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"
								text = "TECHNOLOGY_PROGRESS_TIME_LEFT"
							}
						}

						### PROGRESS
						default_progressbar_horizontal = {
							visible = "[Or(And(GreaterThan_CFixedPoint(Technology.GetProgress(GetPlayer.Self), '(CFixedPoint)0'), Not(Technology.HasResearchedTech(GetPlayer.Self))), GreaterThan_CFixedPoint(GetPlayer.GetMinWeeklyTechnologyProgressForTech(Technology.Self), '(CFixedPoint)0'))]"
							layoutpolicy_horizontal = growing
							size = { 400 25 }
							tooltip = "TECHNOLOGY_GAIN_BREAKDOWN"

							blockoverride "values" {
								max = "[FixedPointToFloat(Technology.GetCost(GetPlayer.Self))]"
								value = "[FixedPointToFloat(Technology.GetProgress(GetPlayer.Self))]"
							}

							textbox = {
								margin_right = 10
								parentanchor = vcenter|right
								align = nobaseline
								autoresize = yes
								text = "TECHNOLOGY_PROGRESS_WITH_GAIN_NO_TOOLTIP"
							}
						}
					}

hbox = {
        name = "v3rqa_held_active"
        visible = "[And(And(GetVariableSystem.Exists('v3rqa_tree_visible'), InformationPanelBar.IsPanelOpen('tech_tree')), And(And(Not(StringIsEmpty(AccessPlayer.GetIDString)), GetVariableSystem.HasValue('v3rqo_viewcountry', AccessPlayer.GetIDString)), And(Not(StringIsEmpty(GetVariableSystem.Get('v3rqo_viewactive'))), And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), GetVariableSystem.HasValue('v3rqo_viewpromotion', '1')))))]"
        datamodel = "[DataModelFirst(GetLegitimacyLevels, Select_int32(And(And(GetVariableSystem.Exists('v3rqa_tree_visible'), InformationPanelBar.IsPanelOpen('tech_tree')), And(And(Not(StringIsEmpty(AccessPlayer.GetIDString)), GetVariableSystem.HasValue('v3rqo_viewcountry', AccessPlayer.GetIDString)), And(Not(StringIsEmpty(GetVariableSystem.Get('v3rqo_viewactive'))), And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), GetVariableSystem.HasValue('v3rqo_viewpromotion', '1'))))), '(int32)1', '(int32)0'))]"
        item = {
            hbox = {
                spacing = 10
                alwaystransparent = yes
                					widget = {
						size = { 80 80 }
                        visible = "[And(Or(GetVariableSystem.HasValue('v3rqo_visual', 'hold'), GetVariableSystem.HasValue('v3rqo_visual', 'slide')), GetVariableSystem.HasValue('v3rqo_viewpromotion', '1'))]"
                        datacontext = "[GetTechnology(Select_CString(StringIsEmpty(GetVariableSystem.Get('v3rqo_viewactive')), 'enclosure', GetVariableSystem.Get('v3rqo_viewactive')))]"
                        alwaystransparent = yes

						icon = {
							parentanchor = center
