# HMPS: research queue arrows from "Construction Queue: Multi-Select & Drag" (freethebrain, Workshop 3837831783, v0.6.0); MP checks removed
template tech_tree_divider 
{
	using = dark_area
	alpha = 1
	parentanchor = hcenter
	
	modify_texture = {
		texture = "gfx/interface/masks/fade_horizontal_center.dds"
		spriteType = Corneredstretched
		spriteborder = { 0 0 }
		blend_mode = alphamultiply
		alpha = 1
	}
}

types tech_tree
{
	type tech_tree_panel = fullscreen_block_window {
		hbox = {
		        size = { 0 0 }
		        alwaystransparent = yes
		        datamodel = "[DataModelFirst(GetLegitimacyLevels, Select_int32(And(GetVariableSystem.Exists('v3rqa_tree_visible'), And(InformationPanelBar.IsPanelOpen('tech_tree'), GetPlayer.HasCurrentlyResearchedTechnology)), '(int32)1', '(int32)0'))]"
		        item = { widget = {
		name = "v3rqa_queue_controller"
		size = { 0 0 }
		alwaystransparent = yes
		widget = {
		    size = { 0 0 }
		    alwaystransparent = yes
		    state = {
		        name = v3rqd_b09544899e_register_academia
		        trigger_when = "[Or(And(Not(GetVariableSystem.Exists('v3rqd_b09544899e_k_academia')), Or(GetTechnology('academia').IsResearching(GetPlayer.Self), And(GreaterThan_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)0'), LessThanOrEqualTo_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)8')))), Or(And(And(GreaterThan_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)0'), LessThanOrEqualTo_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)8')), Not(GetVariableSystem.HasValue(Concatenate('v3rqo_slot', ToString_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self))), 'academia'))), And(GetTechnology('academia').IsResearching(GetPlayer.Self), Not(GetVariableSystem.HasValue('v3rqo_observed_active', 'academia')))))]"
		        on_start = "[GetVariableSystem.Set('v3rqd_b09544899e_d_rationalism>academia', 'yes')]"
		        on_start = "[GetVariableSystem.Set(Concatenate('v3rqd_b09544899e_name_', GetTechnology('academia').GetNameNoFormatting), 'academia')]"
		        on_start = "[GetVariableSystem.SetIf(Concatenate('v3rqo_slot', ToString_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self))), 'academia', And(GreaterThan_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)0'), LessThanOrEqualTo_int32(GetTechnology('academia').GetResearchQueuePosition(GetPlayer.Self), '(int32)8')))]"
		        on_start = "[GetVariableSystem.SetIf('v3rqo_observed_active', 'academia', GetTechnology('academia').IsResearching(GetPlayer.Self))]"
		        on_start = "[GetVariableSystem.Set('v3rqd_b09544899e_k_academia', 'yes')]"
		    }
		}
		widget = {
		    size = { 0 0 }
		    alwaystransparent = yes
		    state = {
		        name = v3rqd_b09544899e_register_admiralty
