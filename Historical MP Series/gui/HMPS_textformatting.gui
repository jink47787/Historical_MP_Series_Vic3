# HMPS text formats, added alongside vanilla's gui/textformatting.gui. This is added for the BoT GUI element to be properly yellow
textformatting = {
	### HMPS YELLOW VALUE: a true yellow (vanilla "yellow" is a pale cream), bold and shadowed like positive_value/negative_value.
	### Used for the topbar Balance of Trade surplus (gui/topbar.gui)
	format = {
		name = hmps_yellow_value
		format = "color:{ 1, 0.85, 0.2 };bold;shadow"
	}
}
