template goods_filter_button
{
	using = filter_button_sound
	framesize = { 89 83 }
	gfxtype = framedbuttongfx
	effectname = "NoHighlight"
	upframe = 1
	overframe = 2
	downframe = 3
}

prestige_good_change_name_popup_type = {
	name = prestige_good_change_name_popup
}

types prestige_good_change_name
{
	type prestige_good_change_name_popup_type = default_popup
	{
		datacontext = "[PrestigeGoodChangeNamePopup.GetPrestigeGood]"

		blockoverride "window_header_name"
		{
			text = "CHANGE_NAME"
		}

		blockoverride "header_close_button_visibility"
		{
			visible = yes
		}

		blockoverride "header_close_button"
		{
			visible = yes
			onclick = "[PopupManager.HidePrestigeGoodChangeName]"
		}

		blockoverride "entire_scrollarea"
		{
			flowcontainer = {
				direction = vertical

				# "Choose Name" section
				flowcontainer = {
					direction = vertical
					spacing = 10

					# Set a custom name
					editbox = {
						visible = yes
						background = {
							using = text_edit_bg
						}

						# The name is referenced in code. If you change it, it will no longer get properly reset
						name = "prestige_good_name_edit"
						ontextedited = "[PrestigeGoodChangeNamePopup.OnEditName]"
						maxcharacters = 50
						size = { 420 40 }
						margin_left = 10
						alwaystransparent = no
						focuspolicy = all
						focus_on_visible = yes
						align = left|nobaseline
					}

					flowcontainer = {
						direction = horizontal
						using = default_list_position
						spacing = 20

						button = {
							using = default_button
							using = close_button_sound
							size = { 140 40 }
							text = "CANCEL"
							shortcut = "close_window"
							onclick = "[PopupManager.HidePrestigeGoodChangeName]"
						}
						button = {
							using = default_button_primary_action
							using = confirm_button_sound
							name = "confirmation_button"
							size = { 140 40 }
							text = "CONFIRM"
							enabled = "[IsValid(PrestigeGoodChangeNamePopup.Confirm)]"
							onclick = "[Execute(PrestigeGoodChangeNamePopup.Confirm)]"
							tooltip = "[GetDesc(PrestigeGoodChangeNamePopup.Confirm)]"
							onclick = "[PopupManager.HidePrestigeGoodChangeName]"
						}
					}

					widget = {
						size = { 420 10 }
					}
				}


			}
		}

		blockoverride "bottom_margin"
		{
			margin_bottom = 50
		}
	}
}
