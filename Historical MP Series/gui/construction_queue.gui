            v3qr_insertion_line = {
                parentanchor = top|left
                visible = "[EqualTo_int32(ConstructionQueueElement.GetQueueNumber, FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_first').GetValueWithDefault('(CFixedPoint)0')))]"
            }
            v3qr_insertion_line = {
                parentanchor = bottom|left
                visible = "[EqualTo_int32(ConstructionQueueElement.GetQueueNumber, FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_last').GetValueWithDefault('(CFixedPoint)0')))]"
            }
        }
    }
            }
        }
    }
}
