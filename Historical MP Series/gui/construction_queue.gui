# HMPS: based on "Construction Queue: Multi-Select & Drag" (freethebrain, Workshop 3837831783, v0.6.0)
# HMPS: MP enabled; multiplayer checks removed, timeouts lengthened
# COPY-PASTED FOR NOW
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

@queue_item_width = 540
@queue_item_height = 40

types construction_queue {
	type v3qt_help_tooltip = TooltipWidgetType {
	    blockoverride "text" {
	        text = "V3QT_QUEUE_HELP"
	    }
	    blockoverride "tooltip_margins" {
	        margin = { 18 15 }
	        margin_right = 46
	    }
	    blockoverride "tooltip_content_free_floating" {
	        close_button = {
	            name = "v3qt_help_dismiss_button"
	            size = { 28 28 }
	            parentanchor = top|right
	            widgetanchor = top|right
	            position = { -10 10 }
	            enabled = "[Not(GetVariableSystem.Exists('v3qt_help_dismiss_requested'))]"
	            blockoverride "tooltip" {}
	            onclick = "[GetVariableSystem.Set('v3qt_help_dismiss_requested', 'yes')]"
	            onclick = "[GetVariableSystem.Set('v3qt_help_compact', 'yes')]"
	            onclick = "[PdxGuiTriggerAllAnimations('v3qt_help_tooltip_dismiss')]"
	        }
	    }
	    state = {
	        name = _show
	        alpha = 1
	        scale = 1
	        duration = 0
	    }
	    state = {
	        name = v3qt_help_tooltip_dismiss
	        alpha = 0
	        scale = 0.92
	        duration = 0.16
	        using = Animation_Curve_Default
	    }
	}

	type v3qr_grip_dot = icon {
		texture = "gfx/interface/backgrounds/white.dds"
		color = { 0.81 0.73 0.56 1 }
		size = { 3 3 }
		alwaystransparent = yes
	}

	type v3qr_insertion_line = icon {
		texture = "gfx/interface/backgrounds/white.dds"
		color = { 0.45 0.86 0.94 1 }
		size = { 100% 3 }
		alwaystransparent = yes
	}

	type v3qt_native_government_row = construction_queue_item {
        draggable_behavior = {
            draggable_id = "construction_queue_element"
            drag_widget = {
                widget = {
                    size = { 1 1 }
                    construction_queue_item = {
                        position = "[GuiCurrentDrag.CurrentPosition]"
                        widgetanchor = center
                    }
                }
            }
        }
        drop_target = {
            accept_draggable_id = "construction_queue_element"
            on_receive_drop = "[Execute( GetDraggedDatacontext( 'ConstructionQueueElement' ).MoveToIndex( ConstructionQueueElement.GetIndex ) )]"
        }
    }

	type v3qt_government_row = construction_queue_item {
state = {
    name = v3qd_release_visual
    on_start = "[GetVariableSystem.SetIf('v3qd_hold', 'yes', And(And(GetVariableSystem.HasValue('v3qd_eligible', 'yes'), GetVariableSystem.Exists('v3qt_hover')), And(Not(GetVariableSystem.HasValue('v3qt_hover', '')), And(GetVariableSystem.HasValue('v3qd_token', GetVariableSystem.Get('v3qt_hover')), And(And(And(GetVariableSystem.Exists('v3qt_session'), Country.IsLocalPlayer), And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(And(GetVariableSystem.HasValue('v3qd_owner', AccessPlayer.GetIDString), GetVariableSystem.HasValue('v3qd_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry)))), And(GetVariableSystem.HasValue('v3qd_size', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, Or(GetVariableSystem.HasValue('v3qd_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0')))), And(GetVariableSystem.HasValue('v3qd_accepted_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0')))), Or(GetPlayer.MakeScope.Var('v3qt_remaining').IsSet, Or(GetPlayer.MakeScope.Var('v3qt_refreshing').IsSet, GetVariableSystem.Exists('v3qt_sent')))))))))))))]"
    on_start = "[GetVariableSystem.Set('v3qd_eligible', 'no')]"
    on_start = "[GetVariableSystem.Clear('v3qt_hover')]"
}
state = {
    name = v3qd_capture_artwork
    on_start = "[GetVariableSystem.SetIf(Concatenate('v3qd_icon_', ToString_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))))), ConstructionQueueElement.GetBuilding.GetBuildingType.GetKey, And(GreaterThanOrEqualTo_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))), '(int32)0'), LessThanOrEqualTo_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))), '(int32)11')))]"
    on_start = "[GetVariableSystem.SetIf(Concatenate('v3qd_label_', ToString_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))))), Concatenate3(ConstructionQueueElement.GetBuilding.GetName, ' in ', Concatenate(AddTextIf(Not(ConstructionQueueElement.GetState.GetOwner.IsLocalPlayer), ConstructionQueueElement.GetState.GetOwner.GetFlagTextIcon), ConstructionQueueElement.GetBuilding.GetState.GetName)), And(GreaterThanOrEqualTo_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))), '(int32)0'), LessThanOrEqualTo_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Add_int32('(int32)1', Multiply_int32(Subtract_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry), '(int32)1'), GetDataModelSize(AccessPlayer.AccessPagedGovernmentConstructionQueue('(int32)1', ConstructionPanel.GetFilter))))), '(int32)11')))]"
}
		blockoverride "v3qt_rank" {
		    button = {
		        name = "v3qt_rank_selector"
		        size = { 32 38 }
		        enabled = "[And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(ConstructionQueueElement.GetInvestorCountry.IsLocalPlayer, Not(Or(And(And(GetVariableSystem.Exists('v3qt_session'), And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(GetVariableSystem.HasValue('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, EqualTo_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_size').GetValueWithDefault('(CFixedPoint)0'))))))), GreaterThan_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_remaining').GetValueWithDefault('(CFixedPoint)0')), '(int32)0')), Or(And(And(GetVariableSystem.Exists('v3qt_session'), And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(GetVariableSystem.HasValue('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, EqualTo_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_size').GetValueWithDefault('(CFixedPoint)0'))))))), And(EqualTo_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_remaining').GetValueWithDefault('(CFixedPoint)0')), '(int32)0'), GetVariableSystem.Exists('v3qt_sent'))), GetPlayer.MakeScope.Var('v3qt_refreshing').IsSet)))))]"
		        click_modifiers = {
		            ondefault = "[PdxGuiWidget.TriggerAnimation('v3qt_pick')]"
		            onshift = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.Exists('v3qt_session'), And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(GetVariableSystem.HasValue('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, EqualTo_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_size').GetValueWithDefault('(CFixedPoint)0'))))))), 'v3qt_extend', 'v3qt_pick'))]"
		        }
				state = {
					name = v3qt_pick
					on_start = "[GetVariableSystem.Clear('v3qt_sent')]"
					on_start = "[GetVariableSystem.Clear('v3qt_refresh_row')]"
					on_start = "[GetVariableSystem.Set('v3qt_snapshot', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))]"
					on_start = "[GetVariableSystem.Set('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry)))]"
					on_start = "[GetScriptedGui('v3qt_select_idle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('row', MakeScopeValue(IntToFixedPoint(ConstructionQueueElement.GetQueueNumber))).AddScope('size', MakeScopeValue(IntToFixedPoint(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))).AddScope('job', MakeScopeValue(IntToFixedPoint(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0'))))).End)]"
					on_start = "[PdxGuiTriggerAllAnimations('v3qt_capture_slot')]"
					on_start = "[PdxGuiTriggerAllAnimations('v3qt_register_building')]"
					on_start = "[GetVariableSystem.Set('v3qt_session', 'yes')]"
				}
				state = {
					name = v3qt_extend
					on_start = "[GetScriptedGui('v3qt_extend_idle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('row', MakeScopeValue(IntToFixedPoint(ConstructionQueueElement.GetQueueNumber))).AddScope('size', MakeScopeValue(IntToFixedPoint(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))).AddScope('job', MakeScopeValue(IntToFixedPoint(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0'))))).End)]"
				}
		        textbox = {
		            parentanchor = center
		            autoresize = yes
		            alwaystransparent = yes
		            raw_text = "##[ConstructionQueueElement.GetQueueNumber]"
		        }
		    }
		}
		background = {
		    visible = "[And(And(GetVariableSystem.Exists('v3qt_session'), And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(GetVariableSystem.HasValue('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, EqualTo_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_size').GetValueWithDefault('(CFixedPoint)0'))))))), And(GreaterThanOrEqualTo_int32(ConstructionQueueElement.GetQueueNumber, FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_first').GetValueWithDefault('(CFixedPoint)0'))), LessThanOrEqualTo_int32(ConstructionQueueElement.GetQueueNumber, FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_last').GetValueWithDefault('(CFixedPoint)0')))))]"
		    texture = "gfx/interface/backgrounds/white.dds"
		    color = { 0.20 0.63 0.65 0.42 }
		}
		blockoverride "v3qr_grip" {
			widget = {
				using = visible_if_cqe_player_government
				size = { 12 40 }
				alwaystransparent = yes
				v3qr_grip_dot = { position = { 2 13 } }
				v3qr_grip_dot = { position = { 7 13 } }
				v3qr_grip_dot = { position = { 2 18 } }
				v3qr_grip_dot = { position = { 7 18 } }
				v3qr_grip_dot = { position = { 2 23 } }
				v3qr_grip_dot = { position = { 7 23 } }
			}
		}

		state = {
			name = v3qt_drag_pick
			on_start = "[GetVariableSystem.Clear('v3qt_hover')]"
			on_start = "[GetVariableSystem.Set('v3qt_drag_mode', 'single')]"
			on_start = "[GetVariableSystem.Clear('v3qt_sent')]"
			on_start = "[GetVariableSystem.Clear('v3qt_refresh_row')]"
			on_start = "[GetVariableSystem.Set('v3qt_snapshot', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))]"
			on_start = "[GetVariableSystem.Set('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry)))]"
			on_start = "[GetScriptedGui('v3qt_select_idle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('row', MakeScopeValue(IntToFixedPoint(ConstructionQueueElement.GetQueueNumber))).AddScope('size', MakeScopeValue(IntToFixedPoint(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))).AddScope('job', MakeScopeValue(IntToFixedPoint(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0'))))).End)]"
			on_start = "[PdxGuiTriggerAllAnimations('v3qt_capture_slot')]"
			on_start = "[PdxGuiTriggerAllAnimations('v3qt_register_building')]"
			on_start = "[GetVariableSystem.Set('v3qt_session', 'yes')]"
		
    on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
    on_start = "[GetVariableSystem.Set('v3qd_eligible', 'no')]"
    on_start = "[GetVariableSystem.Set('v3qd_token', '')]"
    on_start = "[GetVariableSystem.Set('v3qd_capture_owner', AccessPlayer.GetIDString)]"
    on_start = "[GetVariableSystem.Set('v3qd_capture_size', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))]"
    on_start = "[GetVariableSystem.Set('v3qd_capture_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry)))]"
    on_start = "[PdxGuiTriggerAllAnimations('v3qd_capture_artwork')]"
}
		state = {
			name = v3qt_drag_keep
			on_start = "[GetVariableSystem.Clear('v3qt_hover')]"
			on_start = "[GetVariableSystem.Set('v3qt_drag_mode', 'selection')]"
		
    on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
    on_start = "[GetVariableSystem.Set('v3qd_eligible', 'no')]"
    on_start = "[GetVariableSystem.Set('v3qd_token', '')]"
