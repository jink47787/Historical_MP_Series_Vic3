	type construction_queue = flowcontainer {
widget = {
    name = "v3qd_hold_lifecycle"
    size = { 1 1 }
    alwaystransparent = yes
    state = {
        name = v3qd_invalidated
        trigger_when = "[And(GetVariableSystem.HasValue('v3qd_hold', 'yes'), Not(And(And(And(GetVariableSystem.Exists('v3qt_session'), Country.IsLocalPlayer), And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(And(GetVariableSystem.HasValue('v3qd_owner', AccessPlayer.GetIDString), GetVariableSystem.HasValue('v3qd_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry)))), And(GetVariableSystem.HasValue('v3qd_size', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue))), And(GetPlayer.MakeScope.Var('v3qt_anchor').IsSet, Or(GetVariableSystem.HasValue('v3qd_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0')))), And(GetVariableSystem.HasValue('v3qd_accepted_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0')))), Or(GetPlayer.MakeScope.Var('v3qt_remaining').IsSet, Or(GetPlayer.MakeScope.Var('v3qt_refreshing').IsSet, GetVariableSystem.Exists('v3qt_sent')))))))))))]"
            on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
    }
    state = {
        name = v3qd_unaccepted_drop
        trigger_when = "[And(GetVariableSystem.HasValue('v3qd_hold', 'yes'), GetVariableSystem.HasValue('v3qd_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0')))))]"
        duration = 0.35
        on_finish = "[GetVariableSystem.SetIf('v3qd_hold', 'no', And(GetVariableSystem.HasValue('v3qd_hold', 'yes'), GetVariableSystem.HasValue('v3qd_generation', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('v3qt_generation').GetValueWithDefault('(CFixedPoint)0'))))))]"
    }
}
		state = {
		    name = v3qt_expire
		    trigger_when = "[And(GetVariableSystem.Exists('v3qt_session'), Not(And(And(Country.IsLocalPlayer, And(ConstructionPanel.IsShowingGovernmentConstructions, Not(ConstructionPanel.IsFiltered('is_domestic')))), And(GetVariableSystem.HasValue('v3qt_page', ToString_int32(ConstructionPanel.AccessCurrentGovernmentConstructionQueuePage(GetMetaPlayer.GetPlayedOrObservedCountry))), GetVariableSystem.HasValue('v3qt_snapshot', ToString_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue)))))))]"
		    on_start = "[GetVariableSystem.Clear('v3qt_session')]"
		    on_start = "[GetScriptedGui('v3qt_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
    on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
}
		state = {
		    name = _show
		    on_start = "[GetVariableSystem.Clear('v3qt_hover')]"
		    on_start = "[GetVariableSystem.Clear('v3qt_session')]"
on_start = "[GetVariableSystem.Clear('v3mc_phase')]"
on_start = "[GetVariableSystem.Clear('v3mc_tick')]"
on_start = "[GetVariableSystem.Clear('v3mc_watching')]"
		    on_start = "[GetVariableSystem.Clear('v3qt_sent')]"
		    on_start = "[GetScriptedGui('v3qt_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
    on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
}
		state = {
		    name = _hide
		    on_start = "[GetVariableSystem.Clear('v3qt_hover')]"
		    on_start = "[GetVariableSystem.Clear('v3qt_session')]"
on_start = "[GetVariableSystem.Clear('v3mc_phase')]"
on_start = "[GetVariableSystem.Clear('v3mc_tick')]"
on_start = "[GetVariableSystem.Clear('v3mc_watching')]"
		    on_start = "[GetVariableSystem.Clear('v3qt_sent')]"
		    on_start = "[GetScriptedGui('v3qt_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
    on_start = "[GetVariableSystem.Clear('v3qd_hold')]"
}
		using = default_list_position
		direction = vertical
		minimumsize = { @panel_width -1 }
		margin_bottom = 10

		flowcontainer = {
			parentanchor = hcenter
			direction = vertical

			background = {
				using = dark_area
			}

			background = {
				using = fade_right_entry_header_colored
				color = "[GetDefine('NGUI','BUILDING_OWNERSHIP_COLOR_PLAYER_POPS')]"
				margin_left = 2
				margin_right = 2
				margin_bottom = -1
			}

			background = {
				using = fade_right_entry_header_colored
				color = "[GetDefine('NGUI','BUILDING_OWNERSHIP_COLOR_PLAYER_POPS')]"
				margin_left = 2
				margin_right = 2
				margin_bottom = -1
				mirror = horizontal
			}

			divider_clean = {}

			widget = {
				size = { @panel_width_plus_14 50 }

				textbox = {
					parentanchor = vcenter
					margin = { 10 10 }
					align = nobaseline
					autoresize = yes
					max_width = 265
					using = elide_fontsize_min
					using = investment_pool_tooltip_with_graph
					text = "CURRENT_INVESTMENT_POOL"
				}

				textbox = {
					parentanchor = vcenter|right
					margin = { 10 10 }
					align = nobaseline
					autoresize = yes
					max_width = 265
					using = elide_fontsize_min
					tooltip = "[GetPlayer.GetPreviousAutonomousInvestmentsDesc]"
					text = "PREVIOUS_INVESTMENTS"
				}
			}

			divider_decorative = {}

			textbox = {
				visible = "[GetPlayer.ShowInvestmentPoolPredictedNextBuilding]"
				parentanchor = hcenter
				minimumsize = { @panel_width_plus_14 -1 }
				maximumsize = { @panel_width_plus_14 -1 }
				margin = { 10 10 }
				autoresize = yes
				multiline = yes
				align = hcenter|nobaseline
				text = "NEXT_PRIVATE_CONSTRUCTION"

				background = {
					using = dark_area
					margin_top = 2
				}
			}

			divider_clean = {}
		}

		default_header_2texts = {
			blockoverride "left" {
				flowcontainer = {
					parentanchor = left|vcenter
					position = { 12 0 }
					spacing = 8
					textbox = {
						text = "CONSTRUCTION_QUEUE"
						autoresize = yes
						max_width = 330
						elide = right
						default_format = "#title"
						using = fontsize_large
						align = left|nobaseline
						parentanchor = vcenter
					}
					widget = {
						name = "v3qt_queue_help"
						size = { 24 24 }
						parentanchor = vcenter
						using = tooltip_ne
						tooltip = "V3QT_QUEUE_HELP"
						state = {
						    name = _show
						    on_start = "[GetVariableSystem.Clear('v3qt_help_dismiss_requested')]"
						}
						state = {
						    name = _hide
						    on_start = "[GetVariableSystem.Clear('v3qt_help_dismiss_requested')]"
						}
						state = {
						    name = v3qt_help_finish_dismiss
						    trigger_when = "[GetVariableSystem.Exists('v3qt_help_dismiss_requested')]"
						    duration = 0.20
						    on_finish = "[GetVariableSystem.Clear('v3qt_help_dismiss_requested')]"
						    on_finish = "[CloseAllTooltips]"
						    on_finish = "[PdxGuiTriggerAllAnimations('v3qt_help_header_glow')]"
						}
						icon = {
						    name = "v3qt_help_header_highlight"
						    texture = "gfx/interface/tutorial/tutorial_highlight_start_glow.dds"
						    size = { 52 52 }
						    parentanchor = center
						    alwaystransparent = yes
						    alpha = 0
						    state = {
						        name = _show
						        alpha = 0
						        scale = 0.85
						        duration = 0
						    }
						    state = {
						        name = v3qt_help_header_glow
						        alpha = 0.9
						        scale = 1.1
						        duration = 0.16
						        next = v3qt_help_header_glow_out
						        using = Animation_Curve_Default
						    }
						    state = {
						        name = v3qt_help_header_glow_out
						        alpha = 0
						        scale = 1.25
						        duration = 0.55
						        using = Animation_Curve_Default
						    }
						}
						textbox = {
							parentanchor = center
							autoresize = yes
							raw_text = "?"
							default_format = "#title"
							alwaystransparent = yes
						}
					}
				}
			}
			blockoverride "text2" {
				block "text" {
					visible = "[And(Country.HasConstructionQueued, Not(Country.IsConstructionPaused))]"
					text = "QUEUE_CONSTRUCTION_POINTS_SUMMARY"
