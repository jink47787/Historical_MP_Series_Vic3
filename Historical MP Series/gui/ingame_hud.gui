trigger_when = "[And(GetVariableSystem.HasValue('vqbs_phase', 'wait'), GetVariableSystem.HasValue('vqbs_old_size', ToString_int32(Subtract_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), '(int32)5'))))]"
