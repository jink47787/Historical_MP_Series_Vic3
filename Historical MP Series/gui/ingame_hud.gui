widget = {
	size = { 100% 100% }
	name = "ingame_hud"
	layer = "layer_ingame_hud"
	ignore_in_debug_draw = yes

	pause_border = {}

	# fullscreens
	using = information_panels_fullscreens

	# vbox with things that should be reduced in size on Y-axis when opening the lens options
	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin_top = 85 #margin topbar

		widget = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			ignore_in_debug_draw = yes

			# lens toolbar
			lens_toolbar = {
				parentanchor = bottom|hcenter
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				name = "message_feed_widget"

				# sidepanels
				using = information_panels
				using = map_list_panels

				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignore_in_debug_draw = yes
				}

				# ultra-wide notifications feed
				vbox = {
					using = half_and_fullscreen_hide
					layoutpolicy_horizontal = preferred
					layoutpolicy_vertical = expanding
					margin_top = 70 #margin construction info

					widget = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						ignore_in_debug_draw = yes
					}

					message_feed_widget = {
						visible = "[And(And( And( Not( IsPauseMenuShown ), Not( IsGameOverScreenShown )), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid), MessageFeedHandler.ShowNotificationFeedNextToOutliner)]"
					}
				}

				# outliner / notifications
				vbox = {
					visible = "[And( And( Not( IsPauseMenuShown ), Not( IsGameOverScreenShown )), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
					layoutpolicy_horizontal = preferred
					layoutpolicy_vertical = expanding
					margin_top = 70 #margin construction info

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						expand = {}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = preferred
								expand = {}

								outliner_wars = {
									using = half_and_fullscreen_hide
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								expand = {}

								outliner = {
									size = { 360 0 }
									layoutpolicy_vertical = expanding
								}
							}
						}
					}
					
					message_feed_widget = {
						visible = "[Not(MessageFeedHandler.ShowNotificationFeedNextToOutliner)]"
					}
				}

			}
		}

		# lens tabs / actions
		lens_option_menu = {
			using = sidebar_margin
		}
	}

	# topbar / alerts / timemanip
	vbox = {
		hbox = {
			layoutpolicy_horizontal = preferred
			layoutpolicy_vertical = preferred

			vbox = {
				layoutpolicy_horizontal = preferred
				layoutpolicy_vertical = preferred

				datacontext = "[AccessMetaPlayer.AccessPlayedOrObservedCountry]"

				# Has navy
				topbar = {
					visible = "[Not(Country.IsLandlocked)]"
				}

				# Landlocked
				topbar = {
					visible = "[Country.IsLandlocked]"

					blockoverride "supply_ships_info" {}

					blockoverride "spacing" {
						spacing = 37
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignore_in_debug_draw = yes
				}
			}
			topfrontend = {}
			timemanip = {}
		}
		widget = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			ignore_in_debug_draw = yes
		}
	}

	# Topbar rank icon
	topbar_rank = {}

	# left sidebar buttons
	information_panel_bar = {}

	widget = {
        size = { 0 0 }
        alwaystransparent = yes
        hbox = {
            size = { 0 0 }
            datamodel = "[DataModelFirst(GetLegitimacyLevels, Select_int32(And(IsInGame, And(GetPlayer.IsValid, GetPlayer.IsLocalPlayer)), '(int32)1', '(int32)0'))]"
            item = { widget = {
# HMPS: queue tools Alt-click to front controller (freethebrain)
name = "vqbs_priority_controller"
size = { 0 0 }
alwaystransparent = yes
widget = { size = { 0 0 } alwaystransparent = yes
state = {
name = vqbs_settle_single
trigger_when = "[And(GetVariableSystem.HasValue('vqbs_phase', 'wait'), GetVariableSystem.HasValue('vqbs_old_size', ToString_int32(Subtract_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), '(int32)1'))))]"
duration = 0.45
on_finish = "[GetVariableSystem.SetIf('vqbs_single_settled', 'yes', And(GetVariableSystem.HasValue('vqbs_phase', 'wait'), GetVariableSystem.HasValue('vqbs_old_size', ToString_int32(Subtract_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), '(int32)1')))))]"
}
}
widget = { size = { 0 0 } alwaystransparent = yes
