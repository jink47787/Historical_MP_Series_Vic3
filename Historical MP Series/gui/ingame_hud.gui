on_start = "[Execute(ConstructionQueueElement.MoveToIndex(Add_int32(Add_int32(Add_int32(Add_int32(Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_0', 'yes'), '(int32)1', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_1', 'yes'), '(int32)2', '(int32)0')), Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_2', 'yes'), '(int32)4', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_3', 'yes'), '(int32)8', '(int32)0'))), Add_int32(Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_4', 'yes'), '(int32)16', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_5', 'yes'), '(int32)32', '(int32)0')), Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_6', 'yes'), '(int32)64', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_7', 'yes'), '(int32)128', '(int32)0')))), Add_int32(Add_int32(Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_8', 'yes'), '(int32)256', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_9', 'yes'), '(int32)512', '(int32)0')), Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_10', 'yes'), '(int32)1024', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_11', 'yes'), '(int32)2048', '(int32)0'))), Add_int32(Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_12', 'yes'), '(int32)4096', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_13', 'yes'), '(int32)8192', '(int32)0')), Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_bit_14', 'yes'), '(int32)16384', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_bit_15', 'yes'), '(int32)32768', '(int32)0'))))), Subtract_int32(Subtract_int32(ConstructionQueueElement.GetQueueNumber, Subtract_int32(GetDataModelSize(AccessPlayer.AccessGovernmentConstructionQueue), Add_int32(Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_count_bit_0', 'yes'), '(int32)1', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_count_bit_1', 'yes'), '(int32)2', '(int32)0')), Add_int32(Select_int32(GetVariableSystem.HasValue('vqbs_count_bit_2', 'yes'), '(int32)4', '(int32)0'), Select_int32(GetVariableSystem.HasValue('vqbs_count_bit_3', 'yes'), '(int32)8', '(int32)0'))))), '(int32)1'))))]"
on_start = "[GetVariableSystem.Set('vqbs_phase', GetVariableSystem.Get('vqbs_after_send'))]"
}
state = {
name = vqbs_send_blocked
on_start = "[GetVariableSystem.Clear('vqbs_phase')]"
on_start = "[GetVariableSystem.Clear('vqbs_batch')]"
}
        } }
    }
state = {
name = vqbs_finish
trigger_when = "[GetVariableSystem.HasValue('vqbs_phase', 'finished')]"
on_start = "[GetVariableSystem.Clear('vqbs_phase')]"
on_start = "[GetVariableSystem.Clear('vqbs_batch')]"
}
hbox = {
        datamodel = "[DataModelFirst(GetLegitimacyLevels, Select_int32(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'a')), '(int32)1', '(int32)0'))]"
        item = { widget = {
            size = { 0 0 }
            alwaystransparent = yes
            state = {
name = vqbs_watch_start_a
trigger_when = "[And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'a'))]"
on_start = "[GetVariableSystem.Set('vqbs_watch_progress_a', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))]"
on_start = "[PdxGuiWidget.TriggerAnimation('vqbs_deadline_a')]"
}
state = {
name = vqbs_deadline_a
duration = 6 # HMPS: was 4; MP latency headroom
on_finish = "[GetVariableSystem.Clear(Select_CString(And(And(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'a')), GetVariableSystem.HasValue('vqbs_watch_progress_a', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))), Not(GetVariableSystem.HasValue('vqbs_phase', 'finished'))), 'vqbs_batch', 'vqbs_inactive_watch'))]"
on_finish = "[GetVariableSystem.Clear(Select_CString(And(And(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'a')), GetVariableSystem.HasValue('vqbs_watch_progress_a', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))), Not(GetVariableSystem.HasValue('vqbs_phase', 'finished'))), 'vqbs_phase', 'vqbs_inactive_watch'))]"
on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'a')), 'vqbs_watch_start_a', 'vqbs_watch_idle_a'))]"
}
state = { name = vqbs_watch_idle_a alpha = 1 }
        } }
    }
hbox = {
        datamodel = "[DataModelFirst(GetLegitimacyLevels, Select_int32(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'b')), '(int32)1', '(int32)0'))]"
        item = { widget = {
            size = { 0 0 }
            alwaystransparent = yes
            state = {
name = vqbs_watch_start_b
trigger_when = "[And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'b'))]"
on_start = "[GetVariableSystem.Set('vqbs_watch_progress_b', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))]"
on_start = "[PdxGuiWidget.TriggerAnimation('vqbs_deadline_b')]"
}
state = {
name = vqbs_deadline_b
duration = 6 # HMPS: was 4; MP latency headroom
on_finish = "[GetVariableSystem.Clear(Select_CString(And(And(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'b')), GetVariableSystem.HasValue('vqbs_watch_progress_b', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))), Not(GetVariableSystem.HasValue('vqbs_phase', 'finished'))), 'vqbs_batch', 'vqbs_inactive_watch'))]"
on_finish = "[GetVariableSystem.Clear(Select_CString(And(And(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'b')), GetVariableSystem.HasValue('vqbs_watch_progress_b', Concatenate(Concatenate(GetVariableSystem.Get('vqbs_phase'), ':'), GetVariableSystem.Get('vqbs_next')))), Not(GetVariableSystem.HasValue('vqbs_phase', 'finished'))), 'vqbs_phase', 'vqbs_inactive_watch'))]"
on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.Exists('vqbs_phase'), GetVariableSystem.HasValue('vqbs_watch_slot', 'b')), 'vqbs_watch_start_b', 'vqbs_watch_idle_b'))]"
}
state = { name = vqbs_watch_idle_b alpha = 1 }
        } }
    }
state = { name = _hide
on_start = "[GetVariableSystem.Clear('vqbs_phase')]"
on_start = "[GetVariableSystem.Clear('vqbs_batch')]"
on_start = "[GetVariableSystem.Clear('vqbs_alt')]"
}
state = { name = _show
on_start = "[GetVariableSystem.Clear('vqbs_phase')]"
on_start = "[GetVariableSystem.Clear('vqbs_batch')]"
on_start = "[GetVariableSystem.Clear('vqbs_alt')]"
}
} }
        }
    }

	# misc
	container = {
		parentanchor = hcenter
		position = { 0 130 }
		using = hud_visibility
		using = default_fade_in_out

		### SAVING GAME TEXT
		textbox = {
			visible = "[IsSaving]"
			parentanchor = hcenter
			text = "SAVING_GAME"
			align = right|nobaseline
			autoresize = yes
			using = fontsize_large
			margin = { 16 8 }

			background = {
				using = paper_bg
			}
		}
	}
	
	#Button
	flowcontainer = {

		name = "free_console_access_button"
		spacing = 3
		ignoreinvisible = yes
		allow_outside = yes
		
		position = { 0 0 }
		dockable_button = {
            visible = "yes"
			text = ""
			onclick = "[ExecuteConsoleCommand('debug_mode')]"
            tooltip = "HMPS_ENABLE_DEBUG"
			shortcut = "screenshot"
			size = { 0 0 }
		}
	}

	# game start animation effect (should continue from the state that the animation from lobby ends in)
	widget = {
		size = { 100% 100% }
		parentanchor = center
		visible = "[IsInGame]"

		state = {
			trigger_on_create = yes
			name = _show

			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_clouds')]"
			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_glow')]"
			on_start = "[PdxGuiTriggerAllAnimations('game_start_menu_logo_v_start')]"
			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_logo')]"
			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_country')]"
			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_country_sound')]"

			on_start = "[PdxGuiTriggerAllAnimations('game_start_animation_effect')]" #shine on golden HUD elements after clouds vanished

			duration = 3
			on_finish = "[PdxGuiWidget.Hide]"
			on_finish = "[PdxGuiTriggerAllAnimations('game_start_menu_animation_reset')]"
		}

		state = {
			name = game_start_animation_country_sound
			start_sound = {
				soundeffect = "event:/SFX/DLC/1.3_ip1/UI/new_country_start"
			}
		}

		### CLOUDS
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/animation/cloud_backdrop.dds"
			parentanchor = center

			state = {
				name = game_start_animation_clouds
				next = game_start_animation_clouds2

				scale = 1.1
				alpha = 1
			}
			state = {
				name = game_start_animation_clouds2

				duration = 3

				scale = 1.3
				alpha = 0
			}
		}
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/animation/cloud_01.dds"
			parentanchor = center

			state = {
				name = game_start_animation_clouds
				next = game_start_animation_clouds2

				scale = 1.2
				alpha = 1
			}
			state = {
				name = game_start_animation_clouds2

				duration = 3

				scale = 1.6
				alpha = 0
			}
		}
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/animation/cloud_02.dds"
			parentanchor = center

			state = {
				name = game_start_animation_clouds
				next = game_start_animation_clouds2

				scale = 1.3
				alpha = 1
			}
			state = {
				name = game_start_animation_clouds2

				duration = 3

				scale = 2
				alpha = 0
			}
		}
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/animation/cloud_03.dds"
			parentanchor = center

			state = {
				name = game_start_animation_clouds
				next = game_start_animation_clouds2

				scale = 1.4
				alpha = 1
			}
			state = {
				name = game_start_animation_clouds2

				duration = 3

				scale = 2.5
				alpha = 0
			}
		}
		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/animation/cloud_04.dds"
			parentanchor = center

			state = {
				name = game_start_animation_clouds
				next = game_start_animation_clouds2

				scale = 1.5
				alpha = 1
			}
			state = {
				name = game_start_animation_clouds2

				duration = 3

				scale = 3
				alpha = 0
			}
		}

		### GLOW EFFECT
		icon = {
			using = rotate_glow_animation_02
			alpha = 0

			state = {
				name = game_start_animation_glow
				next = game_start_animation_glow2

				alpha = 0
			}
			state = {
				name = game_start_animation_glow2
				next = game_start_animation_glow3

				duration = 1
				using = Animation_Curve_Default

				alpha = 1
			}
			state = {
				name = game_start_animation_glow3
				delay = 1

				duration = 1
				using = Animation_Curve_Default

				alpha = 0
			}
		}

		### LOGO
		widget = {
			size = { 800 180 }
			parentanchor = center
			position = { 0 -205 }

			background = {
				using = default_header_bg
				alpha = 0.95

				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_center.dds"
					blend_mode = alphamultiply
				}
			}

			state = {
				name = game_start_animation_logo
				next = game_start_animation_logo2

				position_x = 1500
			}
			state = {
				name = game_start_animation_logo2
				next = game_start_animation_logo3

				duration = 0.4
				using = Animation_Curve_Default

				position_x = -15
			}
			state = {
				name = game_start_animation_logo3
				next = game_start_animation_logo4

				duration = 0.1
				using = Animation_Curve_Default

				position_x = 0
			}
			state = {
				name = game_start_animation_logo4
				delay = 2

				duration = 0.5
				using = Animation_Curve_Default

				position_x = -1500
			}

			v3_logo_animation_game_start = {
				parentanchor = center
			}
		}

		### FLAG + COUNTRY NAME
		flowcontainer = {
			direction = vertical
			datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
			parentanchor = center
			spacing = 20
			position = { -1500 70 }

			margin = { 150 45 }
			margin_bottom = 70

			background = {
				using = default_background
				color = "[GetMetaPlayer.GetPlayedOrObservedCountry.GetMapColor]"
				alpha = 0.85

				modify_texture = {
					using = fancy_pattern_2
				}

				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_center.dds"
					blend_mode = alphamultiply
					alpha = 0.3
				}
				modify_texture = {
					texture = "gfx/interface/animation/start_game_effect_frame_mask.dds"
					texture_density = 2
					spriteType = Corneredstretched
					spriteborder = { 510 0 }
					spriteborder_bottom = 470
					spriteborder_top = 230
					blend_mode = alphamultiply
				}
			}

			background = {
				texture = "gfx/interface/animation/start_game_effect_frame.dds"
				texture_density = 2
				spriteType = Corneredstretched
				spriteborder = { 510 0 }
				spriteborder_bottom = 470
				spriteborder_top = 230
			}

			state = {
				name = game_start_animation_country
				next = game_start_animation_country2

				position_x = -1500
			}
			state = {
				name = game_start_animation_country2
				next = game_start_animation_country3

				duration = 0.4
				using = Animation_Curve_Default

				position_x = 15
			}
			state = {
				name = game_start_animation_country3
				next = game_start_animation_country4

				duration = 0.1
				using = Animation_Curve_Default

				position_x = 0
			}
			state = {
				name = game_start_animation_country4
				delay = 2

				duration = 0.5
				using = Animation_Curve_Default

				position_x = 1500
			}

			widget = {
				size = { 230 180 }
				parentanchor = hcenter

				background = {
					using = blurry_dark_background
					margin = { 130 80 }
				}

				flag_3d_animated = {
					size = { 640 360 }
					scale = 0.5
				}

				observer_mode_overlay = {}

			}

			textbox = {
				visible = "[Country.IsValid]"
				parentanchor = hcenter
				raw_text = "#BOLD [Country.GetNameNoFormatting]#!"
				autoresize = yes
				align = nobaseline
				fontsize = 80
				elide = right
				maximumsize = { 800 -1 }
				using = header_font_fancy
			}
		}

		### clickthrough blocker (you should not be able to click anything until the animation has finished (3 seconds))
		widget = {
			size = { 100% 100% }
			using = clickthrough_blocker
		}
	}
}
