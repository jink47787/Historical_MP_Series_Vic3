# COPY-PASTED FOR NOW
@panel_width_minus_10 = 530			# used to be 450
@panel_width_minus_20 = 520
@panel_width_minus_30 = 510
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types journal
{
	type journal_panel = default_block_window {
		name = "journal_panel"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/journal"
				}
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/journal_stop"
				}
			}
		}

		blockoverride "window_header_name"
		{
			text = "JOURNAL_WINDOW_HEADER"
		}

		blockoverride "fixed_top" {
			tab_buttons = {
				blockoverride "first_button" {
					text = "JOURNAL_ENTRIES_CONCEPT"
				}
				blockoverride "first_button_tooltip" {
					tooltip = "JOURNAL_ENTRIES_CONCEPT"
				}
				blockoverride "first_button_click" {
					onclick = "[InformationPanel.SelectTab('default')]"
				}
				blockoverride "first_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('default')]"
				}
				blockoverride "first_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('default') )]"
				}
				blockoverride "first_button_selected" {
					text = "JOURNAL_ENTRIES_CONCEPT"
				}
				blockoverride "first_button_name" {
					name = "tutorial_highlight_journal"
				}

				blockoverride "second_button" {
					text = "DECISIONS"
				}
				blockoverride "second_button_tooltip" {
					tooltip = "DECISIONS"
				}
				blockoverride "second_button_click" {
					onclick = "[InformationPanel.SelectTab('inactive_journal_entries')]"
				}
				blockoverride "second_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('inactive_journal_entries')]"
				}
				blockoverride "second_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('inactive_journal_entries') )]"
				}
				blockoverride "second_button_selected" {
					text = "DECISIONS"
				}

				blockoverride "third_button" {
					text = "NATION_FORMATION"
				}
				blockoverride "third_button_tooltip" {
					tooltip = "NATION_FORMATION"
				}
				blockoverride "third_button_click" {
					onclick = "[InformationPanel.SelectTab('nation_formation')]"
				}
				blockoverride "third_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('nation_formation')]"
				}
				blockoverride "third_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('nation_formation') )]"
				}
				blockoverride "third_button_selected" {
					text = "NATION_FORMATION"
				}
			}
		}

		blockoverride "scrollarea_content" {

			flowcontainer = {
				direction = vertical
				using = default_list_position
				margin_top = 5
				spacing = 5

				### JOURNAL
				flowcontainer = {
					visible = "[InformationPanel.IsTabSelected('default')]"
					parentanchor = hcenter
					direction = vertical
					using = default_content_fade

					### Player Objective
					flowcontainer = {
						visible = "[GetPlayer.HasObjective]"
						parentanchor = hcenter
						direction = vertical

						default_header = {
							blockoverride "text" {
								text = "concept_strategic_objective_short"
							}
						}

						flowcontainer = {
							direction = vertical
							minimumsize = { @panel_width_plus_20 150 }
							maximumsize = { @panel_width_plus_20 150 }

							background = {
								using = simple_frame
								alpha = 0.85
								texture = "[AccessPlayer.GetObjective.GetIllustration]"

								modify_texture = {
									using = simple_frame_mask
								}
							}

							### GAME OBJECTIVES
							container = {
								minimumsize = { @panel_width_plus_20 35 }

								background = {
									margin = { -2 -2 }
									using = dark_area
									alpha = 0.65

									modify_texture = {
										texture = "gfx/interface/masks/fade_vertical_bottom.dds"
										blend_mode = alphamultiply
										alpha = 0.6
									}
								}

								flowcontainer = {
									margin_top = 3
									parentanchor = hcenter

									icon = {
										texture = "[AccessPlayer.GetObjective.GetIcon]"
										size = { 27 27 }
									}

									textbox = {
										text = "[AccessPlayer.GetObjective.GetName]"
										default_format = "#header"
										autoresize = yes
										max_width = 200
										margin_top = 4
										using = elide_fontsize_min
									}
								}
							}

							empty_state = {
								minimumsize = { @panel_width 150 }
								margin_top = 50

								blockoverride "visible" {
									visible = "[And(IsDataModelEmpty(AccessPlayer.AccessActivePlayerObjectiveJournalEntries), GetPlayer.HasObjective)]"
								}

								blockoverride "text" {
									text = "[AccessPlayer.GetObjective.GetObjectiveType.GetIdleHeader]"
									margin_bottom = 2

									background = {
										using = dark_area
										alpha = 0.35

										modify_texture = {
											texture = "gfx/interface/masks/fade_horizontal_center.dds"
											blend_mode = alphamultiply
											alpha = 1
										}
									}
								}

								blockoverride "hint_visibility" {
									visible = yes
								}

								blockoverride "hint" {
									text = "[AccessPlayer.GetObjective.GetObjectiveType.GetIdleHint]"
								}
							}

							empty_state = {
								blockoverride "visible" {
									visible = "[And(IsDataModelEmpty(AccessPlayer.AccessActiveNonPlayerObjectiveJournalEntries), Not(GetPlayer.HasObjective))]"
								}

								blockoverride "text" {
									text = "NO_JOURNAL_ENTRIES"
								}
							}
						}

						flowcontainer = {
							direction = vertical
							parentanchor = hcenter

							flowcontainer = {
								visible = "[Not(IsDataModelEmpty(AccessPlayer.AccessActivePlayerObjectiveJournalEntries))]"
								direction = vertical
								spacing = 2
								parentanchor = hcenter
								datamodel = "[AccessPlayer.AccessActivePlayerObjectiveJournalEntries]"

								item = {
									journal_entry = {}
								}
							}

							player_objective_additional_entries = {}
						}
					}

					flowcontainer = {
						parentanchor = hcenter
						direction = vertical
						#spacing = 10

						default_header = {
							blockoverride "text" {
								text = "JOURNAL_ENTRIES_CONCEPT"
							}
						}

						flowcontainer = {
							direction = vertical

							background = {
								using = dropdown_background
								margin = { 0 -2 }
							}

							section_header_button = {
								blockoverride "left_text" {
									text = "FILTERS"
									fontsize_min = 12
									elide = right
								}

								blockoverride "right_text" {
									section_header_right_text = {
										text = "[JournalPanel.GetFilterDesc]"
									}
								}

								blockoverride "onclick" {
									onclick = "[GetVariableSystem.Toggle( 'characters_filters' )]"
								}

								blockoverride "onclick_showmore" {
									visible = "[Not(GetVariableSystem.Exists( 'characters_filters' ))]"
								}

								blockoverride "onclick_showless" {
									visible = "[GetVariableSystem.Exists( 'characters_filters' )]"
								}
							}

							flowcontainer = {
								visible = "[GetVariableSystem.Exists( 'characters_filters' )]"
								minimumsize = { @panel_width_plus_14 -1 }
								parentanchor = hcenter
								margin_top = 5
								margin_bottom = 10
								direction = vertical

								editbox = {
									name = "journal_entries_search_bar"
									parentanchor = hcenter
									size = { @panel_width 40 }
									margin_left = 10
									alwaystransparent = no
									focuspolicy = all
									focus_on_visible = yes
									align = nobaseline
									maxcharacters = 120

									background = {
										using = text_edit_bg
									}

									textbox = {
										visible = "[JournalPanel.GetSearchBar.IsQueryEmpty]"
										parentanchor = vcenter
										align = nobaseline
										position = { 10 0 }
										autoresize = yes
										using = elide_fontsize_min
										max_width = @panel_width
										default_format = "#white"
										alpha = 0.5
										text = "JOURNAL_PANEL_SEARCH_BAR_EMPTY_TEXT"
									}
								}

								### Availability Filter
								building_browser_filter_line = {
									parentanchor = hcenter
									blockoverride "line_background" {}

									blockoverride "line_size" {
										size = { @panel_width 38 }
									}

									blockoverride "filter_line_label"
									{
										text = "AVAILABILITY"
									}

									blockoverride "filter_line_buttons"
									{
										building_browser_filter_line_button = {
											text = "ACTIVE"
											align = hcenter|nobaseline

											blockoverride "line_button_tooltip"{
												tooltip = "ACTIVE_JOURNAL_ENTRIES_FILTER_TOOLTIP"
											}

											blockoverride "line_button_onclick" {
												onclick = "[JournalPanel.SetAvailabilityFilter('active')]"
											}

											blockoverride "line_button_icon_texture" {
												visible = no
											}

											blockoverride "line_button_selected" {
												visible = "[JournalPanel.IsAvailabilityFilterSelected('active')]"
											}
										}

										building_browser_filter_line_button = {
											text = "POTENTIAL"
											align = hcenter|nobaseline

											blockoverride "line_button_tooltip"{
												tooltip = "POTENTIAL_JOURNAL_ENTRIES_FILTER_TOOLTIP"
											}

											blockoverride "line_button_onclick" {
												onclick = "[JournalPanel.SetAvailabilityFilter('potential')]"
											}

											blockoverride "line_button_icon_texture" {
												visible = no
											}

											blockoverride "line_button_selected" {
												visible = "[JournalPanel.IsAvailabilityFilterSelected('potential')]"
											}
										}

										building_browser_filter_line_button = {
											text = "CONCLUDED"
											align = hcenter|nobaseline

											blockoverride "line_button_tooltip"{
												tooltip = "CONCLUDED_JOURNAL_ENTRIES_FILTER_TOOLTIP"
											}

											blockoverride "line_button_onclick" {
												onclick = "[JournalPanel.SetAvailabilityFilter('concluded')]"
											}

											blockoverride "line_button_icon_texture" {
												visible = no
											}

											blockoverride "line_button_selected" {
												visible = "[JournalPanel.IsAvailabilityFilterSelected('concluded')]"
											}
										}
									}
								}
							}
						}

						### Journal Entry Groups
						journal_entry_groups_list = {}
					}
				}

				### DECISIONS
				flowcontainer = {
					visible = "[InformationPanel.IsTabSelected('inactive_journal_entries')]"
					using = default_list_position
					using = default_content_fade
					direction = vertical
					spacing = 10
					parentanchor = hcenter

					### DECISIONS
					default_header = {

						blockoverride "text" {
							text = "DECISIONS"
						}

					}

					flowcontainer = {
						using = default_list_position
						direction = vertical
						margin_bottom = 10
						using = default_content_fade

						textbox = {
							visible = "[IsDataModelEmpty(GetPlayer.GetDecisions)]"
							text = NO_DECISIONS
							autoresize = yes
							align = left|nobaseline
							using = fontsize_xxl
							parentanchor = top|hcenter
							margin_bottom = 25
							margin_top = 10
							alpha = 0.3
						}

						dynamicgridbox = {
							parentanchor = hcenter
							datamodel = "[GetPlayer.GetDecisions]"

							item = {
								flowcontainer = {
									margin = { 0 2 }
									direction = vertical

									decision = {
										minimumsize = { @panel_width_minus_30 -1 }
									}
								}
							}
						}
					}
				}

				### NATION FORMATION
				flowcontainer = {
					visible = "[InformationPanel.IsTabSelected('nation_formation')]"
					using = default_list_position
					direction = vertical
					using = default_content_fade

					flowcontainer = {
						using = default_list_position
						direction = vertical
						margin_bottom = 10
						using = default_content_fade


						empty_state = {
							blockoverride "visible" {
								visible = "[IsDataModelEmpty(AccessPlayer.AccessFormableCountries)]"
							}
							blockoverride "text" {
								text = "NO_FORMABLE_COUNTRIES"
							}
						}

						flowcontainer = {
							parentanchor = hcenter
							direction = vertical
							visible = "[Not(IsDataModelEmpty(AccessPlayer.AccessFormableCountries))]"
							datamodel = "[AccessPlayer.AccessFormableCountries]"
							using = default_content_fade

							item = {
								formable_country_button = {}
							}
						}
					}
				}
			}
		}
	}

	### Journal Entry Groups List
	type journal_entry_groups_list = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		margin_top = 10
		spacing = 10

		### Themed groups with active entries
		journal_entry_themed_group_list = {
			blockoverride "themed_group_datamodel" {
				visible = "[Not(IsDataModelEmpty(JournalPanel.GetActiveJournalEntryGroups))]"
				datamodel = "[JournalPanel.GetActiveJournalEntryGroups]"
			}
		}

		### Themed groups whose shown entries are only potential
		journal_entry_themed_group_list = {
			blockoverride "themed_group_datamodel" {
				visible = "[Not(IsDataModelEmpty(JournalPanel.GetPotentialJournalEntryGroups))]"
				datamodel = "[JournalPanel.GetPotentialJournalEntryGroups]"
			}
		}

		### Active entries outside a themed group
		journal_entry_ungrouped_list = {
			blockoverride "ungrouped_datamodel" {
				visible = "[Not(IsDataModelEmpty(JournalPanel.GetUngroupedActiveJournalEntryTypes))]"
				datamodel = "[JournalPanel.GetUngroupedActiveJournalEntryTypes]"
			}
		}

		### Potential entries outside a themed group
		journal_entry_ungrouped_potential = {}

		### Themed groups whose shown entries are only concluded
		journal_entry_themed_group_list = {
			blockoverride "themed_group_datamodel" {
				visible = "[Not(IsDataModelEmpty(JournalPanel.GetConcludedJournalEntryGroups))]"
				datamodel = "[JournalPanel.GetConcludedJournalEntryGroups]"
			}
		}

		### Concluded entries outside a themed group
		journal_entry_ungrouped_concluded = {}
	}

	type journal_entry_themed_group_list = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		spacing = 10

		block "themed_group_datamodel" {}

		item = {
			journal_entry_group_with_illustration = {}
		}
	}

	type journal_entry_ungrouped_list = flowcontainer {
		visible = "[Not(IsDataModelEmpty(JournalPanel.GetUngroupedActiveJournalEntryTypes))]"
		parentanchor = hcenter
		direction = vertical
		spacing = 2
		margin = { 12 6 }
		margin_bottom = 10

		background = {
			using = entry_bg_fancy_dark
		}

		textbox = {
			minimumsize = { @panel_width_minus_20 24 }
			align = nobaseline
			margin_left = 5
			using = elide_fontsize_min
			text = "ADDITIONAL_JOURNAL_ENTRIES"
		}

		flowcontainer = {
			direction = vertical
			spacing = 2

			block "ungrouped_datamodel" {}

			item = {
				journal_entry = {
					datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"

					blockoverride "minimumsize" {
						minimumsize = { @panel_width_minus_20 -1 }
					}
				}
			}
		}
	}

	type journal_entry_group_with_illustration = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		margin_bottom = 5

		background = {
			using = entry_bg_fancy_dark
			using = frame_small_mask
			alpha = 0.85
		}

		background = {
			using = frame_small
		}

		flowcontainer = {
			direction = vertical
			minimumsize = { @panel_width 100 }
			maximumsize = { @panel_width 100 }

			background = {
				margin = { -1 -1 }
				margin_top = -1
				texture = "[JournalEntryGroup.GetIllustration]"
				using = frame_small_mask_top
			}

			textbox = {
				minimumsize = { @panel_width_half 40 }
				margin_left = 13
				default_format = "#bold"
				align = nobaseline
				using = elide_fontsize_min
				text = "[JournalEntryGroup.GetName]"

				background = {
					margin_bottom = 30
					using = dark_area
					alpha = 1
					using = frame_small_mask_top
					using = fade_right_simple
					using = fade_down_simple
				}
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			spacing = 2
			margin = { 0 2 }
			margin_top = -5

			### ACTIVE
			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[JournalPanel.GetFilteredActiveJournalEntryTypes(JournalEntryGroup.AccessSelf)]"

				item = {
					flowcontainer = {
						datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						direction = vertical

						journal_entry = {
							visible = "[JournalEntry.IsHighlighted]"

							blockoverride "minimumsize" {
								minimumsize = { @panel_width_minus_20 56 }
							}

							blockoverride "button_style" {
								using = default_button_primary
							}
						}

						journal_entry = {
							visible = "[Not(JournalEntry.IsHighlighted)]"

							blockoverride "minimumsize" {
								minimumsize = { @panel_width_minus_20 -1 }
							}
						}
					}
				}
			}

			### POTENTIAL
			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[JournalPanel.GetFilteredInactiveJournalEntryTypes(JournalEntryGroup.AccessSelf)]"

				item = {
					potential_journal_entry = {
						blockoverride "minimumsize" {
							minimumsize = { @panel_width_minus_20 -1 }
						}
					}
				}
			}

			### CONCLUDED
			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[JournalPanel.GetFilteredConcludedJournalEntries(JournalEntryGroup.AccessSelf)]"

				item = {
					concluded_journal_entry = {
						blockoverride "minimumsize" {
							minimumsize = { @panel_width_minus_20 -1 }
						}
					}
				}
			}
		}
	}

	type journal_entry_ungrouped_potential = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		visible = "[Not(IsDataModelEmpty(JournalPanel.GetUngroupedPotentialJournalEntryTypes))]"

		section_header_button = {
			blockoverride "layout" {
				size = { @panel_width 38 }
			}

			blockoverride "left_text" {
				text = "POTENTIAL"
			}

			blockoverride "right_text" {
				section_header_right_text = {
					text = "[GetDataModelSize(JournalPanel.GetUngroupedPotentialJournalEntryTypes)]"
				}
			}

			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('journal_entry_ungrouped_collapsed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(Or(Not(GetVariableSystem.Exists('journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)))]"
			}

			blockoverride "onclick_showless" {
				visible = "[Or(Not(GetVariableSystem.Exists('journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty))]"
			}
		}

		flowcontainer = {
			using = default_list_position
			direction = vertical
			visible = "[And(Or(Not(GetVariableSystem.Exists('journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)), InformationPanel.IsTabSelected('default'))]"

			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[JournalPanel.GetUngroupedPotentialJournalEntryTypes]"

				item = {
					potential_journal_entry = {}
				}
			}
		}
	}

	type journal_entry_ungrouped_concluded = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		visible = "[Not(IsDataModelEmpty(JournalPanel.GetUngroupedConcludedJournalEntries))]"

		section_header_button = {
			blockoverride "layout" {
				size = { @panel_width 38 }
			}

			blockoverride "fade" {
				alpha = 0.75
			}

			blockoverride "left_text" {
				text = "CONCLUDED"
			}

			blockoverride "right_text" {
				section_header_right_text = {
					text = "[GetDataModelSize(JournalPanel.GetUngroupedConcludedJournalEntries)]"
				}
			}

			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('completed_journal_entry_ungrouped_collapsed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(Or(Not(GetVariableSystem.Exists('completed_journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)))]"
			}

			blockoverride "onclick_showless" {
				visible = "[Or(Not(GetVariableSystem.Exists('completed_journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty))]"
			}
		}

		flowcontainer = {
			using = default_list_position
			direction = vertical
			visible = "[And(Or(Not(GetVariableSystem.Exists('completed_journal_entry_ungrouped_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)), InformationPanel.IsTabSelected('default'))]"

			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[JournalPanel.GetUngroupedConcludedJournalEntries]"

				item = {
					concluded_journal_entry = {}
				}
			}
		}
	}

	### Player Objective Potential & Completed JEs
	type player_objective_additional_entries = flowcontainer {
		parentanchor = hcenter
		direction = vertical

		### POTENTIAL JOURNAL ENTRIES - OBJECTIVE
		section_header_button = {
			datamodel = "[AccessPlayer.AccessActivePlayerObjectiveInactiveJournalEntryTypes]"

			blockoverride "layout" {
				size = { @panel_width 38 }
			}

			blockoverride "left_text" {
				text = "POTENTIAL"
			}

			blockoverride "right_text" {
				section_header_right_text = {
					text = "[GetDataModelSize(AccessPlayer.AccessActivePlayerObjectiveInactiveJournalEntryTypes)]"
				}
			}

			blockoverride "onclick" {
				enabled = "[Not(IsDataModelEmpty(AccessPlayer.AccessActivePlayerObjectiveInactiveJournalEntryTypes))]"
				onclick = "[GetVariableSystem.Toggle('journal_objective_potential_collapsed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(Or(Not(GetVariableSystem.Exists('journal_objective_potential_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)))]"
			}

			blockoverride "onclick_showless" {
				visible = "[Or(Not(GetVariableSystem.Exists('journal_objective_potential_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty))]"
			}
		}

		flowcontainer = {
			visible = "[And(Or(Not(GetVariableSystem.Exists('journal_objective_potential_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)), InformationPanel.IsTabSelected('default'))]"
			using = default_list_position
			direction = vertical
			spacing = 10

			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[AccessPlayer.AccessActivePlayerObjectiveInactiveJournalEntryTypes]"

				item = {
					journal_entry_type = {
						alpha = 0.75
					}
				}
			}
		}

		## CONCLUDED JOURNAL ENTRIES - OBJECTIVE
		section_header_button = {
			blockoverride "layout" {
				size = { @panel_width 38 }
			}

			blockoverride "fade" {
				alpha = 0.75
			}

			blockoverride "left_text" {
				text = "CONCLUDED"
			}

			blockoverride "right_text" {
				section_header_right_text = {
					text = "[GetDataModelSize(AccessPlayer.AccessActivePlayerObjectiveConcludedJournalEntries)]"
				}
			}

			blockoverride "onclick" {
				enabled = "[Not(IsDataModelEmpty(AccessPlayer.AccessActivePlayerObjectiveConcludedJournalEntries))]"
				onclick = "[GetVariableSystem.Toggle('journal_objective_completed_collapsed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(Or(Not(GetVariableSystem.Exists('journal_objective_completed_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)))]"
			}

			blockoverride "onclick_showless" {
				visible = "[Or(Not(GetVariableSystem.Exists('journal_objective_completed_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty))]"
			}

		}

		flowcontainer = {
			visible = "[And(Or(Not(GetVariableSystem.Exists('journal_objective_completed_collapsed')), Not(JournalPanel.GetSearchBar.IsQueryEmpty)), InformationPanel.IsTabSelected('default'))]"
			using = default_list_position
			direction = vertical

			flowcontainer = {
				direction = vertical
				spacing = 2
				datamodel = "[AccessPlayer.AccessActivePlayerObjectiveConcludedJournalEntries]"

				item = {
					concluded_journal_entry = {}
				}
			}
		}
	}

	### Journal Entry Group Potential & Completed JEs
	type journal_entry = button {
		onmousehierarchyenter = "[PdxGuiWidget.FindChild('journal_pin_button').InterruptThenTriggerAnimation('hide_journal_pin_button','show_journal_pin_button')]"
		onmousehierarchyleave = "[PdxGuiWidget.FindChild('journal_pin_button').InterruptThenTriggerAnimation('show_journal_pin_button','hide_journal_pin_button')]"
		onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
		enabled = "[JournalEntry.IsActive]"

		highlight_tutorial_ui = {
			visible = "[JournalEntry.IsBeingTutorialHighlighted]"
		}

		block "button_style" {
			using = default_button
		}

		tooltipwidget = {
			FancyTooltip_JournalEntry = {}
		}

		block "background" {}

		flowcontainer = {
			resizeparent = yes

			block "minimumsize" {
				minimumsize = { @panel_width -1 }
			}

			block "flowcontainer_properties" {
				margin = { 10 4 }
				spacing = 7
			}

			flowcontainer = {
				direction = vertical
				parentanchor = vcenter
				margin = { 2 2 }

				flowcontainer = {
					spacing = 2

					# completion in progress
					icon = {
						visible = "[JournalEntry.IsProgressing]"
						texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
						tooltip = "JOURNAL_ENTRY_IN_PROGRESS"
						parentanchor = vcenter
						using = tooltip_ne
						using = shimmer

						block "completing_iconsize" {
							size = { 20 20 }
						}

						icon = {
							parentanchor = center
							using = rotate_glow_animation_02
							size = { 300% 300% }
							alpha = 0.5
						}
					}

					# will be activated
					icon = {
						visible = "[JournalEntry.WillBeActivated]"
						size = { 20 20 }
						parentanchor = left|vcenter
						using = shimmer
						tooltip = "JOURNAL_ENTRY_WILL_BE_ACTIVATED"
						texture = "gfx/interface/icons/generic_icons/clock.dds"
					}

					# journal entry icon
					icon = {
						texture = "[JournalEntry.GetIcon]"

						block "iconsize" {
							size = { 30 30 }
						}
					}

					# title
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						align = nobaseline
						default_format = "#header"
						using = elide_fontsize_min
						text = "[JournalEntry.GetName]"

						block "fontsize" {
							using = fontsize_large
						}

						block "textsize" {
							maximumsize = { 240 -1 }
							minimumsize = { 240 -1 }
						}
					}
				}

				# status description - hidden here so journal panel buttons keep an even height, shown in the outliner
				textbox = {
					text = "[JournalEntry.GetStatusDesc]"
					autoresize = yes
					align = nobaseline
					fontsize = 14
					multiline = yes
					elide = right

					block "status_desc_visibility" {
						visible = no
					}

					block "status_desc_textsize" {
						maximumsize = { 240 -1 }
						minimumsize = { 240 -1 }
					}
				}

				# number of possible actions
				textbox = {
					autoresize = yes
					align = nobaseline
					fontsize = 14
					multiline = yes
					text = "JOURNAL_ENTRY_POSSIBLE_ACTIONS"

					block "possible_actions_visibility" {
						visible = no
					}

					block "possible_actions_textsize" {
						maximumsize = { 240 -1 }
						minimumsize = { 240 -1 }
					}
				}

				# progress description
				textbox = {
					autoresize = yes
					align = nobaseline
					multiline = yes
					using = elide_fontsize_min
					text = "[JournalEntry.GetProgressDesc]"
					tooltip = "[JournalEntry.GetGoalDesc]"

					block "textsize" {
						maximumsize = { 240 -1 }
						minimumsize = { 240 -1 }
					}
				}

				flowcontainer = {
					name = "custom_widgets_container"
				}

				# time out info
				flowcontainer = {
					visible = "[And(JournalEntry.CanTimeOut, JournalEntry.IsActive)]"
					spacing = 2

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/clock.dds"
					}

					textbox = {
						autoresize = yes
						fontsize = 14
						align = nobaseline
						parentanchor = vcenter
						elide = right
						max_width = 245
						text = "[JournalEntry.GetTimeoutTooltip]"
					}
				}

				flowcontainer = {
					block "goal_progress_bar_visibility_below_title" {
						visible = no
					}

					block "goal_progress_bar_margins" {}

					default_progressbar_horizontal = {
						block "goal_progressbar_size" {
							size = { 190 3 }
						}

						blockoverride "values" {
							value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
							min = 0
							max = 1
						}
					}
				}

				# scripted progress bars
				flowcontainer = {
					block "scripted_progress_bars_visibility_below_title" {
						visible = no
					}

					journal_entry_scripted_progress_bars = {}
				}
			}

			# progress bar
			flowcontainer = {
				margin = { 0 10 }
				parentanchor = vcenter

				block "goal_progress_bar_visibility_to_the_right" {
					visible = "[And(JournalEntry.HasProgressBar, JournalEntry.IsActive)]"
				}

				default_progressbar_horizontal = {
					block "progressbar_size" {
						size = { 190 3 }
					}
					blockoverride "values" {
						value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
						min = 0
						max = 1
					}
				}
			}

			flowcontainer = {
				parentanchor = vcenter

				block "scripted_progress_bars_visibility_to_the_right" {
					visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedProgressBars ) )]"
				}

				journal_entry_scripted_progress_bars = {}
			}
		}

		# pin button
		widget = {
			size = { 24 24 }
			parentanchor = vcenter|right
			position = { -4 0 }

			block "pin_button_visibility" {
				visible = "[JournalEntry.IsActive]"
			}

			button = {
				name = "journal_pin_button"
				texture = "gfx/interface/outliner/unpinned_icon.dds"
				using = check_button_sound
				size = { 100% 100% }
				visible = "[Not(JournalEntry.IsPinnedInOutliner)]"
				onclick = "[JournalEntry.TogglePinInOutliner]"
				tooltip = "PIN"
				parentanchor = center

				state = {
					name = hide_journal_pin_button
					trigger_on_create = yes
					alpha = 0
					duration = 0.2
					scale = 0.5
				}

				state = {
					name = show_journal_pin_button
					alpha = 1
					duration = 0.15
					scale = 1
				}
			}

			button = {
				using = check_button_sound
				texture = "gfx/interface/outliner/pinned_icon.dds"
				size = { 100% 100% }
				visible = "[JournalEntry.IsPinnedInOutliner]"
				onclick = "[JournalEntry.TogglePinInOutliner]"
				tooltip = "UNPIN"
				parentanchor = center
			}
		}
	}

	### JOURNAL ENTRY TYPE
	type potential_journal_entry = journal_entry {
		datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
		alpha = 0.75

		blockoverride "fontsize" {
			fontsize = 16
		}

		blockoverride "iconsize" {
			size = { 26 26 }
		}

		blockoverride "flowcontainer_properties" {
			margin = { 10 2 }
			spacing = 5
		}

		blockoverride "scripted_progress_bars_visibility_to_the_right" {
			visible = no
		}
	}

	type journal_entry_type = button {
		enabled = no

		block "button_style" {
			using = default_button
		}

		tooltipwidget = {
			FancyTooltip_JournalEntryType = {}
		}

		block "background" {}

		flowcontainer = {
			resizeparent = yes

			block "minimumsize" {
				minimumsize = { @panel_width -1 }
			}

			block "flowcontainer_properties" {
				margin = { 10 1 }
				spacing = 5
			}

			flowcontainer = {
				direction = vertical
				parentanchor = vcenter
				margin = { 2 2 }

				flowcontainer = {
					spacing = 2

					# journal entry icon
					icon = {
						texture = "[JournalEntryType.GetIcon]"

						block "iconsize" {
							size = { 24 24 }
						}
					}

					# title
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						align = nobaseline
						default_format = "#header"
						using = elide_fontsize_min
						text = "[JournalEntryType.GetName]"

						block "fontsize" {
							fontsize = 16
						}

						block "textsize" {
							maximumsize = { 240 -1 }
							minimumsize = { 240 -1 }
						}
					}
				}
			}
		}
	}

	### CONCLUDED JOURNAL ENTRY
	type concluded_journal_entry = flowcontainer {
		tooltipwidget = {
			FancyTooltip_ConcludedJournalEntry = {}
		}

		block "background" {
			background = {
				using = entry_bg_simple
				alpha = 0.7
			}
		}

		block "minimumsize" {
			minimumsize = { @panel_width -1 }
		}

		block "flowcontainer_properties" {
			margin = { 0 2 }
			margin_left = 10
			spacing = 5
		}

		# journal entry icon
		icon = {
			parentanchor = vcenter
			alpha = 0.4
			texture = "[ConcludedJournalEntry.GetType.GetIcon]"

			block "iconsize" {
				size = { 26 26 }
			}
		}

		# title
		textbox = {
			parentanchor = vcenter
			autoresize = yes
			align = nobaseline
			default_format = "#header"
			alpha = 0.4
			using = elide_fontsize_min
			text = "[ConcludedJournalEntry.GetName]"

			block "fontsize" {
				fontsize = 16
			}

			block "textsize" {
				maximumsize = { 240 -1 }
				minimumsize = { 240 -1 }
			}
		}

		# concluded text
		textbox = {
			parentanchor = vcenter
			autoresize = yes
			align = nobaseline
			default_format = "#lore"
			alpha = 0.7
			using = elide_fontsize_min
			text = "CONCLUDED"

			block "fontsize" {
				fontsize = 16
			}

			block "textsize" {
				maximumsize = { 120 -1 }
				minimumsize = { 120 -1 }
			}
		}

		expand = {}

		widget = {
			size = { 82 -1 }
		}

		button_icon_goto = {
			parentanchor = left|vcenter
			size = { 22 22 }
			onclick = "[InformationPanelBar.OpenJournalEntryPanelByType(ConcludedJournalEntry.GetType.AccessSelf)]"
			input_action = "go_to_details"
		}
	}

	type journal_entry_scripted_progress_bars = flowcontainer {
		direction = vertical
		datamodel = "[JournalEntry.GetScriptedProgressBars]"

		block "progressbars_spacing" {
			spacing = 4
		}

		block "scripted_progress_bars_margins" {}

		item = {
			widget = {
				tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"

				block "progressbar_size" {
					size = { 190 7 }
				}

				# Default
				default_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefault]"
					size = { 100% 70% }
					parentanchor = vcenter

					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
				}

				# Default Bad
				bad_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultBad]"
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					size = { 100% 70% }
					parentanchor = vcenter

					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
				}

				#Default Green
				green_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultGreen]"
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					size = { 100% 70% }
					parentanchor = vcenter

					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}

				}

				# Look defined in script
				scripted_progressbar_dynamic = {
					visible = "[ScriptedProgressBar.IsDynamic]"
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					size = { 100% 70% }
					parentanchor = vcenter

					blockoverride "marker_size" {
						size = { 40 20 }
					}
				}
			}
		}
	}

	### DECISION
	type decision = container {
		maximumsize = { @panel_width_minus_30 -1 }
		minimumsize = { @panel_width_minus_30 -1 }

		button_checkbox_label = {
			position = { -10 9 }
			tooltip = "[SelectLocalization(GetPlayer.IsIgnoringDecision(Decision.Self),'TOGGLE_DECISION_NOTIFICATION_DISABLED_TOOLTIP','TOGGLE_DECISION_NOTIFICATION_ENABLED_TOOLTIP')]"
			onclick = "[Execute(GetPlayer.ToggleIgnoreDecision(Decision.Self))]"
			enabled = "[IsValid(GetPlayer.ToggleIgnoreDecision(Decision.Self))]"

			blockoverride "checkbox"
			{
				checked = "[Not(GetPlayer.IsIgnoringDecision(Decision.Self))]"
			}

			blockoverride "text"
			{
			}
		}

		flowcontainer = {
			margin = { 30 10 }
			direction = vertical

			textbox = {
				text = "[Decision.GetName]"
				autoresize = yes
				align = left|nobaseline
				using = fontsize_large
				multiline = yes
				maximumsize = { 420 -1 }
				minimumsize = { 420 -1 }
				default_format = "#header"
			}

			textbox = {
				text = "[Decision.GetDesc]"
				autoresize = yes
				align = left|nobaseline
				multiline = yes
				maximumsize = { 420 -1 }
				minimumsize = { 420 -1 }
			}
		}

		button_icon_check = {
			parentanchor = right|vcenter
			size = { 50 50 }
			tooltip = "[Decision.GetTooltip( GetPlayer )]"
			enabled = "[IsValid( Decision.TakeDecision( GetPlayer ) )]"
			onclick = "[Execute( Decision.TakeDecision( GetPlayer ) )]"

			blockoverride "sound" {
				using = icon_toggle_single_onoff_sound
			}
		}

		divider_clean = {
			parentanchor = bottom
		}
	}
}
