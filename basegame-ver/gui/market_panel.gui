							maximumsize = { 89 -1 }
						}
					}
				}
			}
		}
	}

	type goods_prestige_goods_breakdown_list_item = widget {
		size = { 540 55 }

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5

