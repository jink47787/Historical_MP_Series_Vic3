	type market_world_market_goods_list_item = widget {
		

		block "market_world_market_goods_list_item_visibility" {
			visible = "[Or(NotZero_CFixedPoint(MarketPanel.GetImportedAmount(Goods.Self)), NotZero_CFixedPoint(MarketPanel.GetExportedAmount(Goods.Self)))]"
		}

		tooltipwidget = {
			FancyTooltip_Goods = {}
		}

		background = {
			alpha = 0.6
			using = entry_bg_fancy_dark
		}

		flowcontainer = {
			direction = vertical
			spacing = 5
			resizeparent = yes
			margin_bottom = 7

			button = {
				onclick = "[InformationPanelBar.OpenGoodsPanel(Goods.GetMarket, Goods.Self)]"
				onrightclick = "[RightClickMenuManager.ShowForGoods(Goods.AccessSelf)]"
				using = default_button
				using = select_button_sound
				
				container = {
					resizeparent = yes

					icon = {
						size = { @panel_width 30 }
						color = "[Goods.GetCategoryColor]"
						texture = "gfx/interface/market_view/trade_good_list_bg.dds"
					}

					flowcontainer = {
						minimumsize = { @panel_width -1 }
						margin_left = -4
						margin_top = 2

						background = {
							using = dark_area
						}
						
						widget = {
							size = { 30 30 }

							icon = {
								size = { 36 36 }
								parentanchor = center
								position = { 0 -1 }
								color = "[Goods.GetCategoryColor]"
								texture = "gfx/interface/market_view/trade_good_icon_bg.dds"
								
								icon = {
									size = { 25 25 }
									parentanchor = center
									texture = "[Goods.GetTexture]"
								}

								icon = {
									visible = "[Goods.HasGoodsShortage]"
									size = { 20 20 }
									parentanchor = bottom|right
									tooltip = "GOODS_SHORTAGE_TOOLTIP"
									texture = "gfx/interface/icons/generic_icons/goods_shortage.dds"
								}
							}
						}

						flowcontainer = {
							margin_top = 2

							textbox = {
								minimumsize = { 130 -1 }
								maximumsize = { 130 -1 }
								margin = { 5 0 }
								align = nobaseline
								autoresize = yes
								using = elide_fontsize_min
								text = "[Goods.GetNameNoFormatting]"
							}

							textbox = {
								minimumsize = { 130 -1 }
								maximumsize = { 130 -1 }
								align = nobaseline
								autoresize = yes
								raw_text = "[Goods.GetMarket.GetOwner.GetFlagTextIcon] @money![Goods.GetMarketPrice|v1] [Goods.GetCompareIconAgainstBasePriceNoFormatting(Goods.GetMarketPrice)]"
							}

							flowcontainer = {
								icon = { 
									size = { 23 23 }
									texture = "gfx/interface/icons/generic_icons/world_market.dds"
								}

								textbox = {
									minimumsize = { 107 -1 }
									maximumsize = { 107 -1 }
									align = nobaseline
									autoresize = yes
									raw_text = "@money![Goods.GetWorldMarketBasePrice|1v] [Goods.GetCompareIconAgainstBasePriceNoFormatting(Goods.GetWorldMarketBasePrice)]"
								}
							}

							textbox = {
								minimumsize = { 110 -1 }
								maximumsize = { 110 -1 }
								align = nobaseline|right
								autoresize = yes
								text = "TOTAL_TARIFFS_SUBVENTIONS_MONEY_MARKET_BALANCE_FOR_GOODS"
							}
						}
					}
				}
			}

			flowcontainer = {
				direction = vertical
				minimumsize = { @panel_width -1 }
				spacing = 5

				flowcontainer = {
					visible = "[Or( NotZero_CFixedPoint(MarketPanel.GetImportedAmount(Goods.Self)), GetVariableSystem.Exists( 'tariffs_show_all' ))]"
					spacing = 5
					margin_left = 10

					icon = {
						texture = "gfx/interface/icons/trade_icons/imports.dds"
						size = { 23 23 }
						parentanchor = vcenter
					}

					textbox = {
						minimumsize = { 60 -1 }
						maximumsize = { 60 -1 }
						parentanchor = vcenter
						fontsize_min = 12
						autoresize = yes
						align = nobaseline
						alpha = "[TransparentIfZero(MarketPanel.GetImportedAmount(Goods.Self))]"
						tooltip = "[MarketPanel.GetWorldMarketHubImportsDesc(Goods.Self)]"
						text = "[MarketPanel.GetImportedAmount(Goods.Self)|vD]"
					}

					overlappingitembox = {
						size = { 160 18 }
						parentanchor = vcenter
						spacing = 5
						datamodel = "[MarketPanel.AccessExportersToMarket(Goods.Self)]"

						item = {
							small_market_flag = {
								parentanchor = vcenter

								blockoverride "small_market_flag_tooltip" {
									tooltipwidget = {
										FancyTooltip_Market = {
											blockoverride "tooltip_content_before" {
												custom_tooltip_textbox = {
													text = "MARKET_PANEL_PARTNER_TRADE_VALUES"
												}
											}
										}
									}
								}
							}
						}
					}

					widget = {
						size = { 6 6 }
					}

					set_level_bar_import_tariffs = {}
				}

				flowcontainer = {
					visible = "[Or( NotZero_CFixedPoint(MarketPanel.GetExportedAmount(Goods.Self)), GetVariableSystem.Exists( 'tariffs_show_all' ))]"
					spacing = 5
					margin_left = 10

					icon = {
						texture = "gfx/interface/icons/trade_icons/exports.dds"
						size = { 23 23 }
						parentanchor = vcenter
					}
					
					textbox = {
						minimumsize = { 60 -1 }
						maximumsize = { 60 -1 }
						parentanchor = vcenter
						fontsize_min = 12
						autoresize = yes
						align = nobaseline
						alpha = "[TransparentIfZero(MarketPanel.GetExportedAmount(Goods.Self))]"
						tooltip = "[MarketPanel.GetWorldMarketHubExportsDesc(Goods.Self)]"
						text = "[MarketPanel.GetExportedAmount(Goods.Self)|vD]"
					}

					overlappingitembox = {
						size = { 160 18 }
						parentanchor = vcenter
						spacing = 5
						datamodel = "[MarketPanel.AccessImportersFromMarket(Goods.Self)]"

						item = {
							small_market_flag = {
								parentanchor = vcenter

								blockoverride "small_market_flag_tooltip" {
									tooltipwidget = {
										FancyTooltip_Market = {
											blockoverride "tooltip_content_before" {
												custom_tooltip_textbox = {
													text = "MARKET_PANEL_PARTNER_TRADE_VALUES"
												}
											}
										}
									}
								}
							}
						}
					}

					widget = {
						size = { 6 6 }
					}

					set_level_bar_export_tariffs = {}
				}
			}
		}
	}

	type cannot_be_trade_icon = icon {
		visible = "[And3(
			Goods.HasMarketContext,
			Not(Goods.GetMarket.CanTradeGoods(Goods.Self)),
			Not(Goods.IsLocal)
		)]"
		tooltip = "GOODS_CANNOT_BE_TRADED_DUE_TO_TREATY"

		size = { 25 25 }
		texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/prohibit_trade_global_market_treaties.dds"
		parentanchor = bottom|right
	}
}

