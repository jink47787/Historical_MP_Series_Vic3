### Great Game JE List
flowcontainer = {
	name = "widget_je_great_game_active_je_list"

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 4
		datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

		item = {
			flowcontainer = {
				visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_great_game').Self)]"
				direction = vertical
				spacing = 4

				textbox = {
					autoresize = yes
					align = nobaseline
					default_format = "#title"
					margin_bottom = 2
					text = "je_great_game_control_active_je_list_header"
				}

				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

					item = {
						journal_entry = {
							visible = "[Not(ObjectsEqual(JournalEntryType.Self, JournalEntryPanel.GetJournalEntryType.Self))]"
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						}
					}
				}
			}
		}
	}
}
