types tsarpoints_widget_types
{
	type tsarpoints_decree_button = widget {
		size = { 256 124 }
		alpha = "[TransparentIfFalse(IsValid( ScriptedButton.ExecuteEffect ))]"
		tooltip = "je_tp_ukaz_item_tt"

		background = {
			using = entry_bg_fancy_dark

			modify_texture = {
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = add
				alpha = 0.3
				texture = "gfx/interface/backgrounds/paper_texture.dds"
			}
		}

		background = {
			visible = "[ScriptedButton.HasIcon]"
			alpha = 0.2
			using = top_illu_properties
			texture = "[ScriptedButton.GetIcon]"
		}

		background = {
			visible = "[Not(ScriptedButton.HasIcon)]"
			alpha = 0.2
			using = top_illu_properties
			texture = "gfx/interface/illustrations/journal/je_group_illu_tsarpoints.dds"
		}

		vbox = {
			size = { 100% 100% }
			margin = { 6 6 }

			default_header_clean = {
				blockoverride "size" {
					layoutpolicy_horizontal = expanding
					size = { 0 34 }
				}

				blockoverride "text_mod" {
					max_width = 244
				}

				blockoverride "margin" {
					margin = { 6 0 }
				}

				blockoverride "header_background" {
					background = {
						color = { 0.0 0.0 0.0 1.0 }
						alpha = 0.3
						using = entry_bg_mask_top
						texture = "gfx/interface/backgrounds/white.dds"

						modify_texture = {
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
							texture = "gfx/interface/masks/fade_vertical_top.dds"
						}
					}
				}

				blockoverride "text_size" {
					fontsize = 18
				}

				blockoverride "text" {
					raw_text = "#b [ScriptedButton.GetName]#!"
				}
			}

			hbox = {
				name = "decree_icon_row"
				layoutpolicy_horizontal = expanding
				spacing = 6
				margin = { 5 2 }
				margin_top = 6

				widget = {
					layoutpolicy_horizontal = expanding
				}

				flowcontainer = {
					name = "decree_cost_cell"
					spacing = 2
					margin = { 5 0 }

					background = {
						margin = { 1 2 }
						using = entry_bg_simple_solid

						modify_texture = {
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							color = { 0.45 0.45 0.45 1.0 }
							blend_mode = multiply
							texture = "gfx/interface/backgrounds/white.dds"
						}
					}

					icon = {
						size = { 24 24 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/tsarpoint_icons/tsarpoints.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						align = nobaseline
						raw_text = "#r [ScriptedButton.GetCost|0]#!"
					}
				}

				widget = {
					name = "decree_action_cell"
					size = { 32 32 }

					icon = {
						visible = "[ScriptedButton.HasCooldown]"
						size = { 26 26 }
						parentanchor = center
						texture = "gfx/interface/icons/tsarpoint_icons/repeatable_action.dds"
					}

					icon = {
						visible = "[Not(ScriptedButton.HasCooldown)]"
						size = { 26 26 }
						parentanchor = center
						texture = "gfx/interface/icons/tsarpoint_icons/single_use_action.dds"
					}
				}

				widget = {
					visible = "[And( ScriptedButton.HasTag('unlocked_by_ruler'), GetScriptedGui('je_tsarpoints_has_tsar_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					size = { 30 30 }

					character_portrait_mini = {
						visible = "[Character.IsValid]"
						parentanchor = center
						datacontext = "[GetPlayer.MakeScope.Var('tsarpoints_tsar_var').GetCharacter]"
						blockoverride "portrait_button" {}
						blockoverride "tooltip" {}
					}
				}

				widget = {
					visible = "[And( ScriptedButton.HasTag('unlocked_by_favorite'), GetScriptedGui('je_tsarpoints_has_favourite_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					size = { 30 30 }

					character_portrait_mini = {
						visible = "[Character.IsValid]"
						parentanchor = center
						datacontext = "[GetPlayer.MakeScope.Var('tsarpoints_special_var').GetCharacter]"
						blockoverride "portrait_button" {}
						blockoverride "tooltip" {}
					}
				}

				widget = {
					visible = "[And( ScriptedButton.HasTag('unlocked_by_heir'), GetScriptedGui('je_tsarpoints_has_heir_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					size = { 30 30 }

					character_portrait_mini = {
						visible = "[Character.IsValid]"
						parentanchor = center
						datacontext = "[GetPlayer.MakeScope.Var('tsarpoints_heir_var').GetCharacter]"
						blockoverride "portrait_button" {}
						blockoverride "tooltip" {}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
				}
			}

			widget = {
				layoutpolicy_vertical = expanding
			}

			button = {
				size = { 218 31 }
				enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
				onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
				using = default_button_action

				widget = {
					visible = "[ScriptedButton.IsSelected]"
					size = { 218 31 }

					background = {
						using = paper_bg
					}
				}

				textbox = {
					parentanchor = center
					autoresize = yes
					align = center|nobaseline
					text = "je_tp_ukaz_publish_button"
				}

				icon = {
					visible = "[ScriptedButton.IsSelected]"
					using = highlighted_square_selection
				}
			}

			widget = {
				size = { 0 4 }
			}
		}
	}
}

### Character Panel
flowcontainer = {
	name = "widget_je_tsarpoints_characters"
	ignoreinvisible = yes
	margin_bottom = 1

	widget = {
		size = { 510 280 }

		background = {
			margin = { 25 0 }
			alpha = 0.3
			using = top_illu_properties
			texture = "gfx/interface/illustrations/journal/game_obj_illu_economic_dominance.dds"
		}

		# Favourite
		widget = {
			visible = "[GetScriptedGui('je_tsarpoints_has_favourite_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			size = { 145 174 }
			position = { 30 80 }

			character_portrait_medium_torso_tsarpoint = {
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_favorite')]"
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_favorite')]"
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_no_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.GetHighestProminenceCharacterOfRole('character_role_favorite')]"
				scale = 0.9
			}
		}

		# Heir
		widget = {
			visible = "[GetScriptedGui('je_tsarpoints_has_heir_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			size = { 145 174 }
			position = { 340 80 }

			character_portrait_medium_torso_tsarpoint = {
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessHeir]"
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessHeir]"
				scale = 0.9
			}

			character_portrait_medium_torso_tsarpoint_historical_no_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessHeir]"
				scale = 0.9
			}
		}

		# Tsar
		widget = {
			visible = "[GetScriptedGui('je_tsarpoints_has_tsar_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			size = { 320 300 }
			position = { 95 0 }

			character_portrait_xl_torso_tsarpoint = {
				visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessRuler]"
				scale = 0.756

				state = {
					name = update
					trigger_on_create = yes
					on_finish = "[GetScriptedGui('je_tsarpoints_update_characters_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
			}

			character_portrait_xl_torso_tsarpoint_historical_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessRuler]"
				scale = 0.756

				state = {
					name = update
					trigger_on_create = yes
					on_finish = "[GetScriptedGui('je_tsarpoints_update_characters_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
			}

			character_portrait_xl_torso_tsarpoint_historical_no_info_link = {
				visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
				parentanchor = center
				datacontext = "[AccessPlayer.AccessRuler]"
				scale = 0.756

				state = {
					name = update
					trigger_on_create = yes
					on_finish = "[GetScriptedGui('je_tsarpoints_update_characters_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
			}
		}
	}
}

### Status & Modifier Effects
flowcontainer = {
	name = "widget_je_tsarpoints_modifiers"
	ignoreinvisible = yes

	flowcontainer = {
		name = "tsarpoints_fiat_panel"
		direction = vertical
		minimumsize = { 560 -1 }
		maximumsize = { 560 -1 }
		parentanchor = hcenter
		spacing = 5
		margin = { 0 12 }
		margin_top = 10
		ignoreinvisible = yes

		textbox = {
			visible = "[GetScriptedGui('je_tsarpoints_has_points_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			minimumsize = { 560 -1 }
			maximumsize = { 560 -1 }
			autoresize = yes
			align = hcenter|nobaseline
			using = fontsize_large
			text = "je_tsarpoints_status_loc"
		}

		flowcontainer = {
			visible = "[GetScriptedGui('je_tsarpoints_has_points_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			name = "tsarpoints_effect_row"
			parentanchor = hcenter

			flowcontainer = {
				parentanchor = vcenter
				spacing = 6
				datacontext = "[JournalEntry.GetModifier]"
				tooltip = "je_tp_imperial_favor_tt"

				flowcontainer = {
					margin = { 5 5 }

					background = {
						using = entry_bg_simple
					}

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/topbar/authority_icon.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						align = nobaseline
						text = "[Modifier.GetFormattedValueFor('country_authority_add')]"
					}
				}

				flowcontainer = {
					margin = { 5 5 }

					background = {
						using = entry_bg_simple
					}

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/prestige.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						align = nobaseline
						text = "[Modifier.GetFormattedValueFor('country_prestige_add')]"
					}
				}
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			spacing = 6
			ignoreinvisible = yes

			background = {
				alpha = 0.2
				margin = { 10 0 }
				using = entry_bg_fancy_dark
			}

			panel_dropdown = {
				blockoverride "section_header_left_text" {
					text = "je_tp_imperial_ukase_header"
				}

				blockoverride "section_header_right_text" {
					raw_text = "#v [GetDataModelSize(JournalEntry.GetScriptedButtons)]#!"
				}

				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('tsarpoints_ukase_collapsed')]"
				}

				blockoverride "onclick_showmore" {
					visible = "[GetVariableSystem.Exists('tsarpoints_ukase_collapsed')]"
				}

				blockoverride "onclick_showless" {
					visible = "[Not(GetVariableSystem.Exists('tsarpoints_ukase_collapsed'))]"
				}

				blockoverride "items_visibility" {
					visible = "[Not(GetVariableSystem.Exists('tsarpoints_ukase_collapsed'))]"
				}

				blockoverride "items_parentanchor" {
					parentanchor = hcenter
				}

				blockoverride "dropdown_datamodel" {
					minimumsize = { 528 -1 }
					maximumsize = { 528 -1 }
					flipdirection = yes
					datamodel_wrap = 2
					datamodel = "[JournalEntry.GetScriptedButtons]"
				}

				blockoverride "item" {
					widget = {
						size = { 264 128 }

						tsarpoints_decree_button = {
							parentanchor = center
						}
					}
				}

				blockoverride "second_list" {}

				blockoverride "empty_state_visibility" {
					visible = no
				}
			}
		}
	}
}

### Favourite JE List
flowcontainer = {
	name = "widget_je_tsarpoints_featured_je"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 4
		margin_top = 6
		ignoreinvisible = yes
		datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

		textbox = {
			visible = "[GetScriptedGui('je_tp_any_favourite_active_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			autoresize = yes
			align = nobaseline
			default_format = "#title"
			margin_bottom = 2
			text = "je_tp_favourite_je_list_header"
		}

		item = {
			flowcontainer = {
				visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_tsarpoints').Self)]"
				direction = vertical
				ignoreinvisible = yes
				datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

				item = {
					journal_entry = {
						visible = "[JournalEntry.HasVariable('tp_favourite_je_var')]"
						datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
					}
				}
			}
		}
	}
}

### Scripted Buttons (registered empty so journal_entry.gui still suppresses its default button grid)
flowcontainer = {
	name = "widget_je_tsarpoints_buttons"
	ignoreinvisible = yes

	widget = {
		size = { 0 0 }
	}
}

### Tsargenda JE List
flowcontainer = {
	name = "widget_je_tsarpoints_active_je_list"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 4
		ignoreinvisible = yes

		textbox = {
			visible = "[GetScriptedGui('je_tp_any_tsar_agenda_active_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			autoresize = yes
			align = nobaseline
			default_format = "#title"
			margin_bottom = 2
			text = "je_tp_active_je_list_header"
		}

		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

			item = {
				flowcontainer = {
					visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_tsarpoints').Self)]"
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

					item = {
						journal_entry = {
							visible = "[JournalEntry.HasVariable('tp_tsar_je_var')]"
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						}
					}
				}
			}
		}
	}
}
