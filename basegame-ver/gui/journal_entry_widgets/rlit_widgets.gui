@rlit_widget_width = 504

### TYPES
types rlit_widget_types
{
	type rlit_section_header = widget {
		size = { @rlit_widget_width 22 }

		textbox = {
			size = { 100% 100% }
			align = nobaseline
			fontsize = 16
			block "header_text" {}
		}
	}

	type rlit_route_row = widget {
		size = { @rlit_widget_width 26 }

		block "row_tooltip" {}

		background = {
			using = dark_area
			alpha = 0.25
		}

		background = {
			block "leading_visible" {}
			texture = "gfx/interface/backgrounds/white.dds"
			color = { 0.85 0.72 0.35 1.0 }
			alpha = 0.18
		}

		icon = {
			block "leading_visible" {}
			size = { 18 18 }
			position = { 8 0 }
			parentanchor = vcenter
			texture = "gfx/interface/icons/generic_icons/checkmark.dds"
		}

		textbox = {
			autoresize = yes
			align = nobaseline
			margin_left = 34
			parentanchor = vcenter
			fontsize = 16
			block "route_name" {}
		}

		textbox = {
			autoresize = yes
			align = right|nobaseline
			margin_right = 10
			parentanchor = right|vcenter
			fontsize = 16
			block "route_points" {}
		}
	}
}

### WIDGETS
flowcontainer = {
	name = "widget_je_rlit_routes"
	direction = vertical
	parentanchor = hcenter
	visible = "[JournalEntry.GetCountry.IsValid]"
	spacing = 2
	margin = { 0 5 }

	divider_clean = {}

	rlit_section_header = {
		blockoverride "header_text" {
			text = "RLIT_ROUTES_HEADER"
		}
	}

	rlit_route_row = {
		blockoverride "row_tooltip" {
			tooltip = "RLIT_ROUTE_OFFICIAL_TT"
		}
		blockoverride "leading_visible" {
			visible = "[GetScriptedGui('rlit_route_official_leads_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
		blockoverride "route_name" {
			text = "RLIT_ROUTE_OFFICIAL"
		}
		blockoverride "route_points" {
			text = "RLIT_ROUTE_OFFICIAL_POINTS"
		}
	}

	rlit_route_row = {
		blockoverride "row_tooltip" {
			tooltip = "RLIT_ROUTE_RADICAL_TT"
		}
		blockoverride "leading_visible" {
			visible = "[GetScriptedGui('rlit_route_radical_leads_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
		blockoverride "route_name" {
			text = "RLIT_ROUTE_RADICAL"
		}
		blockoverride "route_points" {
			text = "RLIT_ROUTE_RADICAL_POINTS"
		}
	}

	rlit_route_row = {
		blockoverride "row_tooltip" {
			tooltip = "RLIT_ROUTE_SPIRITUAL_TT"
		}
		blockoverride "leading_visible" {
			visible = "[GetScriptedGui('rlit_route_spiritual_leads_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
		blockoverride "route_name" {
			text = "RLIT_ROUTE_SPIRITUAL"
		}
		blockoverride "route_points" {
			text = "RLIT_ROUTE_SPIRITUAL_POINTS"
		}
	}

	rlit_route_row = {
		blockoverride "row_tooltip" {
			tooltip = "RLIT_ROUTE_UNIVERSAL_TT"
		}
		blockoverride "leading_visible" {
			visible = "[GetScriptedGui('rlit_route_universal_leads_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
		blockoverride "route_name" {
			text = "RLIT_ROUTE_UNIVERSAL"
		}
		blockoverride "route_points" {
			text = "RLIT_ROUTE_UNIVERSAL_POINTS"
		}
	}
}
